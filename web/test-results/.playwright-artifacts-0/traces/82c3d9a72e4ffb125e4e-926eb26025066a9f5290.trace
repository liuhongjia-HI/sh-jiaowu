splay: block;\n  margin-top: 3px;\n  color: rgba(255, 255, 255, .58);\n  font-size: 12px;\n}\n\n.app-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  min-height: 76px;\n  background: rgba(255, 255, 255, .88);\n  border-bottom: 1px solid rgba(216, 226, 235, .9);\n  padding: 0 28px;\n  backdrop-filter: blur(14px);\n}\n\n.header-title-group {\n  display: grid;\n  gap: 4px;\n}\n\n.header-title-group .ant-typography {\n  margin: 0;\n}\n\n.app-header-title {\n  color: rgba(17, 24, 39, .88);\n  font-size: 20px;\n  font-weight: 700;\n  line-height: 1.35;\n}\n\n.header-eyebrow {\n  color: #667085;\n  font-size: 12px;\n  font-weight: 700;\n}\n\n.question-dialog .ant-modal-body {\n  max-height: calc(100vh - 240px);\n  overflow-y: auto;\n  padding-right: 4px;\n}\n\n.user-pill {\n  min-width: 166px;\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  padding: 7px 10px;\n  border: 1px solid #dfe7ee;\n  border-radius: 8px;\n  background: #fff;\n  box-shadow: 0 8px 20px rgba(15, 23, 42, .05);\n}\n\n.account-trigger {\n  color: inherit;\n  font: inherit;\n  text-align: left;\n  cursor: pointer;\n  transition: border-color .2s ease, background .2s ease, box-shadow .2s ease;\n}\n\n.account-trigger:hover,\n.account-trigger:focus-visible {\n  background: #f8fbfd;\n  border-color: #cfdbe6;\n  box-shadow: 0 10px 24px rgba(15, 23, 42, .08);\n}\n\n.account-trigger:focus-visible {\n  outline: 2px solid rgba(7, 193, 96, .32);\n  outline-offset: 2px;\n}\n\n.account-chevron {\n  margin-left: auto;\n  color: #98a2b3;\n  font-size: 12px;\n}\n\n.user-avatar {\n  width: 32px;\n  height: 32px;\n  display: grid;\n  place-items: center;\n  border-radius: 8px;\n  color: #07c160;\n  background: #e9f8ef;\n}\n\n.user-pill strong,\n.user-pill span {\n  display: block;\n  line-height: 1.2;\n}\n\n.user-pill strong {\n  font-size: 13px;\n}\n\n.user-pill div > span {\n  margin-top: 3px;\n  color: #667085;\n  font-size: 12px;\n}\n\n.app-content {\n  padding: 28px;\