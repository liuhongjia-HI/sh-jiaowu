lign-items: flex-start;\n  }\n}\n\n/* 月视图超出四条时的 \"+N\"。做成和条目同宽的一行，\n   点开是当天完整列表（Popover），和周视图的折叠块行为一致。 */\n.month-overflow-toggle {\n  width: 100%;\n  border: 1px dashed #cbd5e1;\n  border-radius: 4px;\n  background: transparent;\n  color: #475569;\n  padding: 2px 6px;\n  font-size: 12px;\n  cursor: pointer;\n  text-align: left;\n}\n\n.month-overflow-toggle:hover {\n  border-color: #94a3b8;\n  background: #f8fafc;\n}\n\n.month-overflow-list {\n  display: grid;\n  gap: 4px;\n  min-width: 240px;\n  max-width: 320px;\n}\n\n/* 重复课次标记。客户的 Outlook 里每个重复课次右下角都有这个图标。 */\n.schedule-recurrence-mark {\n  color: #64748b;\n  font-size: 12px;\n  flex: 0 0 auto;\n}\n\n.schedule-recurrence-mark.is-detached {\n  color: #b45309;\n}\n\n/* 课程块下沿的拉伸手柄。平时几乎不可见，悬浮到块上才显出来——\n   常驻一条实线会在密排的课表里变成视觉噪音。\n   高度 8px 是可点击的下限，再窄就抓不住。 */\n.schedule-timeline-resize {\n  position: absolute;\n  left: 0;\n  right: 0;\n  bottom: 0;\n  height: 8px;\n  cursor: ns-resize;\n  touch-action: none;\n}\n\n.schedule-timeline-resize::after {\n  content: '';\n  position: absolute;\n  left: 50%;\n  transform: translateX(-50%);\n  bottom: 2px;\n  width: 24px;\n  height: 2px;\n  border-radius: 2px;\n  background: var(--subject-color, #94a3b8);\n  opacity: 0;\n  transition: opacity 0.12s ease;\n}\n\n.schedule-timeline-block:hover .schedule-timeline-resize::after {\n  opacity: 0.7;\n}\n"]],"\n  ",["BODY",{},"\n    ",["DIV",{"id":"root"},["DIV",{"class":"page-loading"},"正在加载页面..."]],"\n    ","\n  \n\n\n"]],"viewport":{"width":1280,"height":720},"timestamp":7037.507,"wallTime":1788080346009,"collectionTime":0.5999999940395355,"resourceOverrides":[],"isMainFrame":true}}
