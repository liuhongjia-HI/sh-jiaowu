gap: 14px 16px;\n}\n\n.permission-card .info-card-field {\n  align-content: start;\n}\n\n.permission-open-groups {\n  display: grid;\n  gap: 12px;\n  padding-top: 12px;\n  border-top: 1px solid #edf0f5;\n}\n\n.permission-open-group {\n  min-width: 0;\n  display: grid;\n  gap: 6px;\n}\n\n.permission-tag-group {\n  min-width: 0;\n  max-width: 100%;\n}\n\n.permission-tag-group .ant-space-item {\n  min-width: 0;\n  max-width: 100%;\n}\n\n.permission-tag-group .ant-tag {\n  max-width: 100%;\n  height: auto;\n  margin-inline-end: 0;\n  white-space: normal;\n  overflow-wrap: anywhere;\n  word-break: break-word;\n  line-height: 1.45;\n}\n\n@media (max-width: 1180px) {\n  .permission-card .info-card-fields {\n    grid-template-columns: 1fr;\n  }\n}\n\n@media (max-width: 720px) {\n  .permissions-card-grid {\n    grid-template-columns: 1fr;\n  }\n\n  .permissions-search {\n    width: 100%;\n  }\n}\n\n.action-button {\n  min-width: 32px;\n  min-height: 32px;\n  border-color: #dbe5ed;\n  background: #fff;\n  font-weight: 700;\n}\n\n.action-button-icon {\n  display: inline-grid;\n  place-items: center;\n  padding-inline: 0;\n}\n\n.action-button:hover {\n  border-color: #07c160 !important;\n  color: #07c160 !important;\n  background: #f2fbf7 !important;\n}\n\n.action-button.ant-btn-dangerous:hover {\n  border-color: #ff4d4f !important;\n  color: #ff4d4f !important;\n  background: #fff1f0 !important;\n}\n\n.preview-result {\n  margin-top: 16px;\n  padding: 14px;\n  border: 1px solid #dfe7ee;\n  border-radius: 8px;\n  background: #f8fafc;\n}\n\n.rich-text-preview {\n  max-width: 360px;\n  color: #344054;\n  font-size: 13px;\n  line-height: 1.55;\n  word-break: break-word;\n}\n\n.rich-text-preview p,\n.rich-text-preview ul,\n.rich-text-preview ol {\n  margin: 0 0 6px;\n}\n\n.rich-text-preview ul,\n.rich-text-preview ol {\n  padding-left: 18px;\n}\n\n.rich-text-preview img {\n  display: block;\n  max-width: 180px;\n  max-height: 120px;\n  margin-top: 6px;\n  border-radius: 6px;\n  object-fit: contain;\n}\n\n.schedule-grid {\n  display: grid;\n  grid-template-columns: minmax(320px, 420px) minmax(0, 1fr);\n  gap: 18px;\n  align-items: start;\n}\n\n.schedule-panel {\n  min-width: 0;\n}\n\n.schedule-slot-list {\n  display: grid;\n  gap: 10px;\n  margin-bottom: 16px;\n}\n\n.schedule-slot-row {\n  display: grid;\n  grid-template-columns: 108px 1fr 1fr auto;\n  gap: 8px;\n  align-items: start;\n}\n\n.schedule-slot-row .ant-form-item {\n  margin-bottom: 0;\n}\n\n.schedule-candidate-form {\n  row-gap: 10px;\n}\n\n.schedule-candidates {\n  margin-top: 16px;\n}\n\n.schedule-workbench {\n  display: grid;\n  gap: 14px;\n}\n\n.schedule-summary-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));\n  gap: 10px;\n}\n\n.schedule-candidate-card {\n  display: grid;\n  gap: 6px;\n  padding: 12px 14px;\n  border: 1px solid #e6ebf2;\n  border-radius: 10px;\n  background: #fbfdfb;\n}\n\n.schedule-candidate-card.is-selected {\n  border-color: #07c160;\n  box-shadow: 0 0 0 2px rgba(7, 193, 96, .12);\n}\n\n.schedule-candidate-head {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 8px;\n}\n\n.schedule-candidate-meta {\n  color: #475569;\n  font-size: 13px;\n}\n\n.schedule-candidate-card .ant-btn {\n  justify-self: start;\n  margin-top: 4px;\n}\n\n.schedule-coordination-list {\n  display: grid;\n  gap: 12px;\n}\n\n.schedule-coordination-item {\n  display: grid;\n  gap: 8px;\n  padding: 12px 14px;\n  border: 1px solid #ffe0b2;\n  border-radius: 10px;\n  background: #fff9f0;\n}\n\n.schedule-coordination-head {\n  display: flex;\n  align-items: center;\n  flex-wrap: wrap;\n  gap: 8px;\n}\n\n.schedule-coordination-body {\n  display: grid;\n  gap: 8px;\n  color: #475569;\n  font-size: 13px;\n}\n\n.schedule-coordination-missing {\n  display: flex;\n  align-items: center;\n  flex-wrap: wrap;\n  gap: 8px;\n}\n\n.schedule-summary-item {\n  min-height: 72px;\n  display: grid;\n  gap: 4px;\n  align-content: center;\n  padding: 12px 14px;\n  border: 1px solid #e6ebf2;\n  border-radius: 8px;\n  background: #f9fbff;\n}\n\n.schedule-summary-item span {\n  color: #64748b;\n  font-size: 13px;\n}\n\n.schedule-summary-item strong {\n  font-size: 24px;\n  line-height: 1;\n}\n\n.schedule-filterbar {\n  display: grid;\n  grid-template-columns: 180px minmax(220px, 1fr) 120px 120px auto;\n  gap: 10px;\n}\n\n.schedule-filterbar.compact {\n  grid-template-columns: 140px;\n}\n\n.schedule-legend {\n  display: flex;\n  align-items: center;\n  gap: 14px;\n  flex-wrap: wrap;\n  color: #5f6b7a;\n  font-size: 13px;\n}\n\n.schedule-result-note {\n  min-height: 22px;\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  flex-wrap: wrap;\n  font-size: 13px;\n}\n\n.schedule-legend span {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n}\n\n.legend-dot {\n  width: 9px;\n  height: 9px;\n  border-radius: 50%;\n  display: inline-block;\n}\n\n.legend-available,\n.legend-available-teacher {\n  background: #8fd3a6;\n}\n\n.legend-available-student {\n  background: #6fb3f2;\n}\n\n.legend-candidate {\n  background: #f5b84b;\n}\n\n.legend-confirmed {\n  background: #07c160;\n}\n\n.legend-canceled {\n  background: #9ca3af;\n}\n\n.schedule-outlook-shell {\n  display: grid;\n  grid-template-columns: 260px minmax(0, 1fr);\n  gap: 14px;\n  align-items: start;\n}\n\n.schedule-outlook-shell.is-collapsed {\n  grid-template-columns: 34px minmax(0, 1fr);\n}\n\n.schedule-outlook-sidebar {\n  display: grid;\n  gap: 12px;\n  position: sticky;\n  top: 76px;\n}\n\n/* display:grid 会盖掉 hidden 属性的默认样式，收起时必须显式关掉。 */\n.schedule-outlook-sidebar[hidden] {\n  display: none;\n}\n\n.schedule-sidebar-collapse {\n  display: flex;\n  justify-content: flex-end;\n  margin-bottom: -4px;\n}\n\n/* 收起后的竖栏：只占一列 34px，写清楚展开能拿到什么，并把生效中的筛选条数标出来。 */\n.schedule-sidebar-rail {\n  position: sticky;\n  top: 76px;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 8px;\n  padding: 10px 0;\n  border: 1px solid #e4e9f1;\n  border-radius: 8px;\n  background: #fff;\n  color: #64748b;\n  cursor: pointer;\n  font: inherit;\n  font-size: 13px;\n}\n\n.schedule-sidebar-rail:hover {\n  border-color: #07c160;\n  color: #07c160;\n}\n\n.schedule-sidebar-rail > span {\n  writing-mode: vertical-rl;\n  letter-spacing: 2px;\n}\n\n.schedule-sidebar-rail .anticon {\n  font-size: 11px;\n}\n\n.schedule-sidebar-rail em {\n  min-width: 18px;\n  padding: 0 5px;\n  border-radius: 9px;\n  background: #07c160;\n  color: #fff;\n  font-size: 11px;\n  font-style: normal;\n  line-height: 18px;\n}\n\n.schedule-sidebar-section {\n  border: 1px solid #e4e9f1;\n  border-radius: 8px;\n  background: #fff;\n  padding: 12px;\n}\n\n.schedule-sidebar-head {\n  min-height: 28px;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 8px;\n  margin-bottom: 10px;\n}\n\n.schedule-sidebar-head strong {\n  color: #111827;\n  font-size: 14px;\n}\n\n.schedule-sidebar-toggle {\n  flex: 1;\n  min-width: 0;\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  padding: 0;\n  border: 0;\n  background: none;\n  cursor: pointer;\n  font: inherit;\n  text-align: left;\n  color: #111827;\n}\n\n.schedule-sidebar-toggle .anticon {\n  color: #94a3b8;\n  font-size: 11px;\n  transform: rotate(-90deg);\n  transition: transform 0.15s ease;\n}\n\n.schedule-sidebar-toggle.is-open .anticon {\n  transform: rotate(0deg);\n}\n\n.schedule-sidebar-toggle em {\n  color: #94a3b8;\n  font-size: 12px;\n  font-style: normal;\n}\n\n.schedule-mini-calendar {\n  display: grid;\n  grid-template-columns: repeat(7, 1fr);\n  gap: 3px;\n}\n\n.schedule-mini-week,\n.schedule-mini-day {\n  height: 28px;\n  display: grid;\n  place-items: center;\n  font-size: 12px;\n}\n\n.schedule-mini-week {\n  color: #64748b;\n  font-weight: 700;\n}\n\n.schedule-mini-day {\n  border: 0;\n  border-radius: 6px;\n  background: transparent;\n  color: #334155;\n  cursor: pointer;\n  font: inherit;\n}\n\n.schedule-mini-day:hover {\n  background: #eef6ff;\n  color: #1d4ed8;\n}\n\n.schedule-mini-day.is-outside {\n  color: #cbd5e1;\n}\n\n.schedule-mini-day.is-week-selected {\n  background: #e8f2ff;\n  color: #1d4ed8;\n}\n\n.schedule-mini-day.is-today {\n  box-shadow: inset 0 0 0 1px #2563eb;\n  font-weight: 700;\n}\n\n/* 日视图选中的是具体一天，用实心底色和整周高亮区分开。\n   写在 is-week-selected / is-today 之后：特异性相同，靠顺序覆盖。 */\n.schedule-mini-day.is-day-selected {\n  background: #2563eb;\n  color: #fff;\n  font-weight: 700;\n}\n\n/* 「这天有课」的圆点：日视图一次只看一天，没有它就看不出该往哪天翻。\n   用 position 定位而不是插 DOM 节点，避免影响 place-items:center 的数字居中。 */\n.schedule-mini-day.has-classes {\n  position: relative;\n}\n\n.schedule-mini-day.has-classes::after {\n  content: '';\n  position: absolute;\n  bottom: 3px;\n  left: 50%;\n  transform: translateX(-50%);\n  width: 4px;\n  height: 4px;\n  border-radius: 50%;\n  background: #2563eb;\n}\n\n.schedule-mini-day.has-classes.is-day-selected::after {\n  background: #fff;\n}\n\n.schedule-day-empty-bar {\n  display: flex;\n  align-items: center;\n  flex-wrap: wrap;\n  gap: 4px 12px;\n  padding: 8px 12px;\n  border: 1px solid #e1e7f0;\n  border-radius: 8px;\n  background: #f8fafc;\n  color: #64748b;\n  font-size: 13px;\n}\n\n.schedule-subject-list,\n.schedule-sidebar-filters {\n  display: grid;\n  gap: 8px;\n}\n\n.schedule-subject-toggle {\n  width: 100%;\n  min-height: 32px;\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  border: 1px solid #e5eaf2;\n  border-radius: 7px;\n  background: #fff;\n  color: #1f2937;\n  cursor: pointer;\n  font: inherit;\n  text-align: left;\n  padding: 6px 8px;\n}\n\n.schedule-subject-toggle i {\n  width: 12px;\n  height: 12px;\n  border-radius: 50%;\n  background: var(--subject-color);\n  flex: 0 0 auto;\n}\n\n.schedule-subject-toggle span {\n  min-width: 0;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.schedule-subject-toggle:hover {\n  border-color: var(--subject-color);\n  background: #f8fafc;\n}\n\n.schedule-subject-toggle.is-muted {\n  color: #94a3b8;\n  background: #f8fafc;\n}\n\n.schedule-subject-toggle.is-muted i {\n  opacity: .35;\n}\n\n.schedule-outlook-main {\n  min-width: 0;\n  display: grid;\n  gap: 12px;\n}\n\n.schedule-timeline-wrap {\n  display: grid;\n  gap: 12px;\n}\n\n.schedule-timeline-toolbar {\n  min-height: 48px;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n  border: 1px solid #e4e9f1;\n  border-radius: 8px;\n  background: #fff;\n  padding: 10px 12px;\n}\n\n.schedule-timeline-toolbar .ant-typography {\n  margin: 0;\n}\n\n.schedule-timeline-toolbar > div:last-child {\n  min-width: 0;\n  text-align: right;\n}\n\n/* 必须给滚动容器一个高度上限，它才真的成为滚动容器。\n   没有上限时容器会长到内容高度（14 小时 ≈ 1232px），滚的是整个页面，\n   于是 .schedule-day-head 的 position:sticky 失去可滚动祖先——\n   往下翻到晚上的课时，泳道表头（老师是谁）整个消失，资源视图最关键的信息没了。 */\n.schedule-timeline-scroll {\n  overflow: auto;\n  max-height: calc(100vh - 260px);\n  min-height: 420px;\n  border: 1px solid #e1e7f0;\n  border-radius: 8px;\n  background: #fff;\n}\n\n/* 列数由实际天数决定，不写死 7：工作周视图只有 5 列，\n   写死 7 会多出两条空列，而且 min-width 撐着不放会让 5 列被压窄。 */\n.schedule-timeline-grid {\n  --day-count: 7;\n  min-width: calc(64px + var(--day-count) * 128px);\n  display: grid;\n  grid-template-columns: 64px repeat(var(--day-count), minmax(128px, 1fr));\n  grid-template-rows: 74px var(--timeline-height);\n}\n\n/* 资源泳道视图：列数由老师/教室数量决定，不是固定的 7 天。\n   min-width 用列数算出来，泳道少时靠 1fr 撑满容器，泳道多时横向滚动，\n   每条始终不低于 190px——这个宽度才放得下课程名 + 班型 + 人数，\n   也是这个视图相对周视图的全部意义所在。 */\n/* grid-template-columns 由组件内联给出（参考泳道要窄一档），这里只留兜底和最小宽度。 */\n.schedule-timeline-grid.is-resource {\n  min-width: calc(64px + var(--lane-count) * 190px);\n  grid-template-columns: 64px repeat(var(--lane-count), minmax(190px, 1fr));\n}\n\n.schedule-day-head-spacer,\n.schedule-day-head {\n  position: sticky;\n  top: 0;\n  z-index: 8;\n  border-bottom: 1px solid #e1e7f0;\n  background: #fff;\n}\n\n.schedule-day-head {\n  display: grid;\n  align-content: center;\n  gap: 2px;\n  padding: 10px 12px;\n  border-left: 1px solid #e9edf4;\n}\n\n.schedule-day-head strong {\n  color: #2563eb;\n  font-size: 24px;\n  line-height: 1;\n}\n\n.schedule-day-head span {\n  color: #334155;\n  font-size: 13px;\n  font-weight: 700;\n}\n\n.schedule-day-head small {\n  color: #64748b;\n  font-size: 12px;\n}\n\n/* 泳道表头放的是老师/教室名字，不是周视图那个大号日期数字。\n   必须写在 .schedule-day-head 之后：两条选择器特异性相同，靠顺序覆盖。 */\n.schedule-lane-head strong {\n  color: #0f172a;\n  font-size: 15px;\n  line-height: 1.3;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.schedule-lane-head span {\n  color: #64748b;\n  font-size: 12px;\n  font-weight: 400;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.schedule-time-gutter {\n  background: #fbfcff;\n}\n\n.schedule-time-axis {\n  position: relative;\n  border-right: 1px solid #e1e7f0;\n}\n\n.schedule-time-label {\n  position: absolute;\n  right: 10px;\n  transform: translateY(-9px);\n  color: #64748b;\n  font-size: 12px;\n  line-height: 18px;\n}\n\n.schedule-day-column {\n  position: relative;\n  border-left: 1px solid #e9edf4;\n  background: #fff;\n}\n\n.schedule-day-column:hover {\n  background: #fcfdff;\n}\n\n.schedule-time-line {\n  position: absolute;\n  left: 0;\n  right: 0;\n  height: 1px;\n  background: #edf1f6;\n}\n\n.schedule-time-line:nth-child(even) {\n  background: #f5f7fb;\n}\n\n.schedule-day-empty-slot {\n  position: absolute;\n  top: 16px;\n  left: 10px;\n  right: 10px;\n  height: 34px;\n  border: 1px dashed #cbd5e1;\n  border-radius: 7px;\n  background: #fff;\n  color: #94a3b8;\n  cursor: pointer;\n  font: inherit;\n  font-size: 13px;\n}\n\n.schedule-day-empty-slot:hover {\n  border-color: #2563eb;\n  color: #1d4ed8;\n  background: #eff6ff;\n}\n\n.schedule-timeline-block {\n  position: absolute;\n  z-index: 2;\n  overflow: hidden;\n  border: 1px solid var(--subject-border);\n  border-left: 5px solid var(--subject-accent);\n  border-radius: 6px;\n  background: var(--subject-bg);\n  color: var(--subject-text);\n  padding: 0;\n  text-align: left;\n  font: inherit;\n  box-shadow: 0 1px 2px rgba(15, 23, 42, .05);\n  /* size 而不是 inline-size：块的高度由课程时长决定（30 分钟只有 40px），\n     只按宽度降级的话，短课和长课塞进去的行数一样多，短块里的字会挤成一团。\n     块的宽高都由内联样式写死，两个方向都做尺寸containment 是安全的。 */\n  container-type: size;\n}\n\n/* 内边距挂在 body 上而不是块本身：容器查询只能作用于容器的后代，\n   写在 .schedule-timeline-block 上的规则会被静默忽略。 */\n.schedule-timeline-body {\n  display: grid;\n  align-content: start;\n  gap: 2px;\n  height: 100%;\n  padding: 7px 8px;\n}\n\n/* 同一时段并排的课程越多，每块越窄。按实际宽度从次要到主要依次隐藏，\n   保证任何宽度下课程名都完整可读；被隐藏的信息仍在 title 悬浮提示里，\n   点击块本身也能打开完整详情。 */\n@container (max-width: 150px) {\n  .schedule-timeline-block small {\n    display: none;\n  }\n}\n\n@container (max-width: 118px) {\n  .schedule-timeline-block .schedule-timeline-tags {\n    display: none;\n  }\n}\n\n@container (max-width: 92px) {\n  .schedule-timeline-block .schedule-timeline-subtitle {\n    display: none;\n  }\n\n  /* 窄块里 8px 内边距会吃掉近一半可用宽度，一并收窄。 */\n  .schedule-timeline-body {\n    padding: 5px 4px;\n  }\n}\n\n@container (max-width: 64px) {\n  .schedule-timeline-block .schedule-timeline-time {\n    display: none;\n  }\n\n  .schedule-timeline-block strong {\n    font-size: 12px;\n  }\n}\n\n/* 按块高度逐档降级。块高 = 课程时长：30 分钟只有 40px，1 小时 84px。\n   原来不管多高都渲染 5 行（时间/标题/学科年级/学生/标签），1 小时的块里\n   5 行叠在 84px 内，字挤成一团——这正是「日视图还是挤」的来源。\n   通行做法（Google Calendar、Outlook、Teamup）是一小时的块只显示标题和时间，\n   其余走点击详情。这里按 1V1 教培实际要扫的信息排优先级：\n   标题 > 时间 > 学生（跟谁上）> 标签 > 学科年级。\n   标签排在学生后面是因为班型（1V1）已经写在标题里了，人数和状态可以 hover 看。 */\n@container (max-height: 116px) {\n  /* 学科年级和泳道副标题重复，最先让位。 */\n  .schedule-timeline-block .schedule-timeline-subtitle {\n    display: none;\n  }\n}\n\n@container (max-height: 92px) {\n  .schedule-timeline-block .schedule-timeline-tags {\n    display: none;\n  }\n}\n\n@container (max-height: 62px) {\n  .schedule-timeline-block small {\n    display: none;\n  }\n}\n\n@container (max-height: 42px) {\n  .schedule-timeline-block .schedule-timeline-time {\n    display: none;\n  }\n\n  .schedule-timeline-body {\n    padding: 3px 8px;\n  }\n\n  .schedule-timeline-block strong {\n    font-size: 12px;\n  }\n}\n\nbutton.schedule-timeline-block {\n  cursor: pointer;\n}\n\nbutton.schedule-timeline-block:hover {\n  z-index: 4;\n  border-color: var(--subject-accent);\n  box-shadow: 0 8px 18px rgba(15, 23, 42, .12);\n}\n\n/* 只作用于单行文本元素：body 和 tags 现在也是 span，不能用裸 span 选择器，\n   否则它们会被 nowrap/ellipsis 影响到布局。 */\n.schedule-timeline-block strong,\n.schedule-timeline-block .schedule-timeline-subtitle,\n.schedule-timeline-block small,\n.schedule-timeline-time {\n  min-width: 0;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.schedule-timeline-time {\n  font-size: 12px;\n  font-weight: 800;\n}\n\n.schedule-timeline-block strong {\n  font-size: 13px;\n  line-height: 1.25;\n}\n\n.schedule-timeline-block .schedule-timeline-subtitle {\n  font-size: 12px;\n  line-height: 1.25;\n}\n\n.schedule-timeline-block small {\n  color: rgba(30, 41, 59, .72);\n  font-size: 12px;\n  line-height: 1.25;\n}\n\n.schedule-timeline-tags {\n  display: flex;\n  align-items: center;\n  gap: 3px;\n  flex-wrap: wrap;\n  min-height: 18px;\n}\n\n.schedule-timeline-tags .ant-tag {\n  margin-inline-end: 0;\n  font-size: 11px;\n  line-height: 16px;\n}\n\n/* 可排时段是背景层：铺满整列、垫在课程下面，课程块永远压在它上面。\n   淡化走 color-mix 而不是 opacity：opacity 会连里面的标签一起压淡，\n   而标签正是这条带子唯一说明自己是什么的地方，必须保持可读。 */\n.schedule-timeline-block.is-availability {\n  z-index: 1;\n  border-style: dashed;\n  pointer-events: none;\n  background: color-mix(in srgb, var(--subject-bg) 62%, #fff);\n  border-color: color-mix(in srgb, var(--subject-border) 62%, #fff);\n  border-left-color: color-mix(in srgb, var(--subject-accent) 62%, #fff);\n  color: color-mix(in srgb, var(--subject-text) 82%, #fff);\n  /* 标签要能 sticky 到滚动容器上：overflow:hidden / container-type:size 都会\n     把这个块变成自己的滚动/包含边界，sticky 就只在块内部生效（等于没生效）。 */\n  overflow: visible;\n  container-type: normal;\n}\n\n/* 贴顶标签：带子的顶部一旦滚出视野，剩下的就是一块没人看得懂的色块。\n   sticky 让说明跟着可视区走；78px = 粘在顶部的日期表头 74px + 4px 呼吸位。 */\n.schedule-availability-label {\n  position: sticky;\n  top: 78px;\n  z-index: 1;\n  display: grid;\n  gap: 1px;\n  width: fit-content;\n  max-width: calc(100% - 8px);\n  margin: 3px 4px;\n  padding: 2px 7px;\n  border-radius: 6px;\n  background: rgba(255, 255, 255, .86);\n}\n\n.schedule-availability-headline {\n  display: flex;\n  align-items: baseline;\n  gap: 5px;\n  min-width: 0;\n}\n\n.schedule-availability-label strong,\n.schedule-availability-label small {\n  min-width: 0;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.schedule-availability-label small {\n  color: inherit;\n  opacity: .78;\n}\n\n/* \"+N\" 折叠块：中性配色，不抢真实课程的视觉权重，但要一眼看出可点。 */\n.schedule-timeline-block.is-overflow {\n  border-color: #cbd5e1;\n  border-left-color: #94a3b8;\n  background: #f8fafc;\n  color: #475569;\n  cursor: pointer;\n}\n\n.schedule-timeline-block.is-overflow .schedule-timeline-body {\n  align-content: center;\n  justify-items: center;\n}\n\n.schedule-timeline-block.is-overflow strong {\n  font-size: 13px;\n  font-weight: 800;\n}\n\n.schedule-timeline-block.is-overflow:hover {\n  border-color: #94a3b8;\n  background: #f1f5f9;\n}\n\n.schedule-overflow-list {\n  display: grid;\n  gap: 4px;\n  max-width: 260px;\n  max-height: 320px;\n  overflow-y: auto;\n}\n\n.schedule-overflow-entry {\n  display: grid;\n  gap: 2px;\n  padding: 8px 10px;\n  border: 1px solid #e2e8f0;\n  border-radius: 8px;\n  background: #fff;\n  text-align: left;\n  font: inherit;\n  cursor: pointer;\n}\n\n.schedule-overflow-entry:hover {\n  border-color: #93c5fd;\n  background: #eff6ff;\n}\n\n.schedule-overflow-entry strong {\n  font-size: 13px;\n}\n\n.schedule-overflow-entry span,\n.schedule-overflow-entry small {\n  color: rgba(30, 41, 59, .72);\n  font-size: 12px;\n}\n\n.schedule-timeline-block.is-selected {\n  box-shadow: inset 0 0 0 1px var(--subject-accent), 0 8px 18px rgba(15, 23, 42, .12);\n}\n\n.schedule-timeline-block.is-canceled {\n  border-color: #cbd5e1;\n  border-left-color: #94a3b8;\n  background: #f1f5f9;\n  color: #64748b;\n  text-decoration: line-through;\n}\n\n/* 已取消课程的幽灵条：靠右侧竖排，只表达「这个时段原本有课、现在空出来了」。\n   斜纹底纹让它一眼就和在排的课区分开，不需要读字，细节走 title 悬浮提示。 */\n.schedule-timeline-block.is-ghost {\n  z-index: 1;\n  padding: 0;\n  border: 1px solid #d3dae4;\n  border-left: 1px solid #d3dae4;\n  border-radius: 3px;\n  box-shadow: none;\n  text-decoration: none;\n  background: repeating-linear-gradient(\n    45deg,\n    #eef2f7,\n    #eef2f7 3px,\n    #dde4ee 3px,\n    #dde4ee 6px\n  );\n}\n\n@container (max-width: 118px) {\n}\n\n.week-board {\n  display: grid;\n  grid-template-columns: repeat(7, minmax(156px, 1fr));\n  gap: 10px;\n  overflow-x: auto;\n  padding-bottom: 4px;\n}\n\n.week-board-wrap {\n  display: grid;\n  gap: 12px;\n}\n\n.week-day {\n  min-width: 156px;\n  border: 1px solid #e6ebf2;\n  border-radius: 8px;\n  background: #fbfcff;\n  overflow: hidden;\n}\n\n.week-day-header {\n  min-height: 48px;\n  padding: 10px 12px;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 8px;\n  border-bottom: 1px solid #e6ebf2;\n  background: #fff;\n}\n\n.week-day-header strong {\n  font-size: 15px;\n}\n\n.week-day-header span {\n  color: #6b7280;\n  font-size: 12px;\n  white-space: nowrap;\n}\n\n.week-day-body {\n  min-height: 220px;\n  padding: 10px;\n  display: grid;\n  align-content: start;\n  gap: 8px;\n}\n\n.week-day-empty {\n  min-height: 120px;\n  display: grid;\n  place-items: center;\n  color: #9ca3af;\n  font-size: 13px;\n}\n\n.week-day-create {\n  width: 100%;\n  border: 1px dashed #cbd5e1;\n  border-radius: 8px;\n  background: #fff;\n  cursor: pointer;\n  font: inherit;\n}\n\n.week-day-create:hover {\n  border-color: #07c160;\n  color: #047857;\n  background: #f0fdf4;\n}\n\n.week-day-add {\n  width: 100%;\n  height: 36px;\n  border: 1px dashed #cbd5e1;\n  border-radius: 8px;\n  background: #fff;\n  color: #64748b;\n  cursor: pointer;\n  font: inherit;\n}\n\n.week-day-add:hover {\n  border-color: #07c160;\n  color: #047857;\n  background: #f0fdf4;\n}\n\n.schedule-block {\n  width: 100%;\n  min-height: 104px;\n  display: grid;\n  gap: 5px;\n  align-content: start;\n  padding: 10px;\n  border: 1px solid #dfe7f3;\n  border-radius: 8px;\n  background: #fff;\n  color: #1f2937;\n  text-align: left;\n  font: inherit;\n}\n\nbutton.schedule-block {\n  cursor: pointer;\n}\n\nbutton.schedule-block:hover {\n  border-color: #07c160;\n  box-shadow: 0 8px 20px rgba(7, 193, 96, .12);\n}\n\n.schedule-block-time {\n  color: #334155;\n  font-size: 12px;\n  font-weight: 700;\n}\n\n.schedule-block-title {\n  min-width: 0;\n  font-size: 14px;\n  font-weight: 700;\n  line-height: 1.35;\n  word-break: break-word;\n}\n\n.schedule-block-course {\n  min-width: 0;\n  color: #334155;\n  font-size: 12px;\n  line-height: 1.4;\n  word-break: break-word;\n}\n\n.schedule-block-meta,\n.schedule-block-students {\n  min-width: 0;\n  color: #64748b;\n  font-size: 12px;\n  line-height: 1.4;\n  word-break: break-word;\n}\n\n.schedule-block-students {\n  color: #1f2937;\n}\n\n.schedule-block-students strong {\n  color: #475569;\n  font-weight: 700;\n}\n\n.schedule-block-tags {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 4px;\n  min-height: 22px;\n}\n\n.schedule-block-tags .ant-tag {\n  margin-inline-end: 0;\n}\n\n.schedule-block-available {\n  min-height: 78px;\n  border-color: #b8e7c6;\n  background: #f0fbf4;\n}\n\n.schedule-block-available.availability-student {\n  border-color: #b9d8fb;\n  background: #eef6ff;\n}\n\n.schedule-block-candidate {\n  border-color: #f3cf82;\n  background: #fff8e8;\n}\n\n.schedule-block-candidate.candidate-full {\n  border-color: #9bd7ac;\n  background: #f1fbf4;\n}\n\n.schedule-block-candidate.candidate-ready {\n  border-color: #a9dfbd;\n  background: #f1fbf4;\n}\n\n.schedule-block-candidate.candidate-short {\n  border-color: #e5e7eb;\n  background: #f5f6f8;\n  color: #6b7280;\n}\n\n.schedule-block-candidate.is-selected {\n  border-color: #d89216;\n  box-shadow: inset 0 0 0 1px #d89216;\n}\n\n.schedule-block-class {\n  border-color: #a9dfbd;\n  background: #f1fbf4;\n}\n\n.schedule-block-class.is-canceled {\n  border-color: #d1d5db;\n  background: #f3f4f6;\n  color: #6b7280;\n}\n\n.schedule-empty-tips {\n  display: grid;\n  gap: 12px;\n  padding: 18px;\n  border: 1px solid #e8ecf3;\n  border-radius: 8px;\n  background: #fbfcff;\n}\n\n.schedule-empty-tips.compact {\n  padding: 12px;\n}\n\n.schedule-action-summary {\n  display: grid;\n  gap: 8px;\n  padding: 14px;\n  border: 1px solid #e6ebf2;\n  border-radius: 8px;\n  background: #f8fafc;\n}\n\n.schedule-action-summary .ant-typography {\n  margin: 0;\n}\n\n.month-board {\n  display: grid;\n  grid-template-columns: repeat(7, minmax(132px, 1fr));\n  gap: 10px;\n  overflow-x: auto;\n  padding-bottom: 4px;\n}\n\n.month-day {\n  min-width: 132px;\n  min-height: 154px;\n  border: 1px solid #e6ebf2;\n  border-radius: 8px;\n  background: #fbfcff;\n  overflow: hidden;\n}\n\n.month-day-head {\n  height: 42px;\n  padding: 8px 10px;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  border-bottom: 1px solid #e6ebf2;\n  background: #fff;\n}\n\n.month-day-head strong {\n  font-size: 16px;\n}\n\n.month-day-head span {\n  color: #64748b;\n  font-size: 12px;\n}\n\n.month-day-body {\n  display: grid;\n  gap: 6px;\n  padding: 8px;\n}\n\n.month-day-empty {\n  padding-top: 34px;\n  text-align: center;\n  color: #9ca3af;\n  font-size: 12px;\n}\n\n/* 月视图条目是单行的：一格要放得下四条，多行 grid 一条就占掉整格。\n   学科主色只做左侧色条和底色，不整块上色——月视图一格四条，\n   四块饱和色排在一起会盖掉「哪天忙」这个总览信息。 */\n.month-class {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  width: 100%;\n  border: 1px solid transparent;\n  border-left: 3px solid var(--subject-color, #94a3b8);\n  border-radius: 4px;\n  background: var(--subject-bg, #f8fafc);\n  padding: 3px 6px;\n  color: #1f2937;\n  text-align: left;\n  cursor: pointer;\n  font-size: 12px;\n  line-height: 1.5;\n  min-width: 0;\n}\n\n.month-class:hover {\n  border-color: var(--subject-color, #94a3b8);\n}\n\n.month-class-time {\n  color: #475569;\n  font-variant-numeric: tabular-nums;\n  flex: 0 0 auto;\n}\n\n/* 教师/年级/科目/学生挤在一行，超宽省略；完整内容在 title 里。 */\n.month-class-text {\n  flex: 1 1 auto;\n  min-width: 0;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.month-class.is-canceled {\n  border-color: #d1d5db;\n  background: #f3f4f6;\n  color: #6b7280;\n}\n\n.page-loading {\n  min-height: 100vh;\n  display: grid;\n  place-items: center;\n  color: #4b5563;\n}\n\n.dashboard-hero {\n  min-height: 148px;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 24px;\n  padding: 28px;\n  border: 1px solid #dfe7ee;\n  border-radius: 8px;\n  background:\n    linear-gradient(135deg, rgba(15, 143, 114, .12), rgba(37, 99, 235, .08)),\n    #fff;\n  box-shadow: 0 20px 50px rgba(15, 23, 42, .08);\n}\n\n.dashboard-hero h2.ant-typography {\n  max-width: 780px;\n  margin: 10px 0 6px;\n  color: #132333;\n  font-size: 30px;\n  line-height: 1.18;\n}\n\n.metric-card {\n  height: 100%;\n  border: 0;\n  box-shadow: 0 14px 34px rgba(15, 23, 42, .07);\n}\n\n.metric-card .ant-statistic-title {\n  color: #667085;\n  font-size: 13px;\n  font-weight: 700;\n}\n\n.metric-card .ant-statistic-content {\n  color: #132333;\n  font-size: 32px;\n  font-weight: 800;\n}\n\n.metric-card span {\n  display: block;\n  margin-top: 8px;\n  color: #667085;\n  font-size: 13px;\n}\n\n.metric-green {\n  background: linear-gradient(180deg, #ffffff, #eefbf6);\n}\n\n.metric-blue {\n  background: linear-gradient(180deg, #ffffff, #eef6ff);\n}\n\n.metric-amber {\n  background: linear-gradient(180deg, #ffffff, #fff7e8);\n}\n\n.metric-purple {\n  background: linear-gradient(180deg, #ffffff, #f6f2ff);\n}\n\n.todo-list {\n  display: grid;\n  gap: 12px;\n}\n\n.todo-item {\n  display: grid;\n  grid-template-columns: 42px minmax(0, 1fr) 18px;\n  align-items: center;\n  gap: 12px;\n  min-height: 82px;\n  padding: 14px;\n  border: 1px solid #e3eaf0;\n  border-radius: 8px;\n  background: #fbfdff;\n  color: inherit;\n  transition: border-color .18s ease, box-shadow .18s ease, transform .18s ease;\n}\n\n.todo-item:hover {\n  transform: translateX(2px);\n  border-color: #b8c8d8;\n  box-shadow: 0 14px 30px rgba(15, 23, 42, .08);\n  color: inherit;\n}\n\n.todo-item strong,\n.todo-item span {\n  display: block;\n}\n\n.todo-item strong {\n  margin-bottom: 4px;\n  color: #17202a;\n}\n\n.todo-item div > span {\n  color: #667085;\n  font-size: 13px;\n}\n\n.todo-icon {\n  width: 42px;\n  height: 42px;\n  display: grid;\n  place-items: center;\n  border-radius: 8px;\n  color: #07c160;\n  background: #e9f8ef;\n}\n\n.todo-item.high .todo-icon {\n  color: #1683f3;\n  background: #eaf2ff;\n}\n\n.todo-item.warning .todo-icon {\n  color: #d97706;\n  background: #fff4df;\n}\n\n.health-panel {\n  display: grid;\n  grid-template-columns: 136px 1fr;\n  align-items: center;\n  gap: 12px;\n}\n\n.health-panel h5.ant-typography {\n  margin: 0 0 6px;\n}\n\n.process-list {\n  display: grid;\n  gap: 10px;\n  margin-top: 18px;\n}\n\n.process-list div {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  padding: 10px 12px;\n  border-radius: 8px;\n  background: #f7fafc;\n  color: #344054;\n}\n\n.readiness-summary {\n  display: grid;\n  gap: 8px;\n  margin-bottom: 14px;\n}\n\n.readiness-list {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));\n  gap: 12px;\n}\n\n.readiness-item {\n  display: grid;\n  grid-template-columns: 28px 1fr;\n  gap: 10px;\n  padding: 12px;\n  border: 1px solid #e2e8f0;\n  border-radius: 8px;\n  background: #fff;\n}\n\n.readiness-item.ready {\n  border-color: #bbf7d0;\n}\n\n.readiness-item.warning {\n  border-color: #fde68a;\n}\n\n.readiness-item.missing {\n  border-color: #fecaca;\n}\n\n.readiness-icon {\n  color: #64748b;\n  font-size: 18px;\n  padding-top: 2px;\n}\n\n.readiness-item.ready .readiness-icon {\n  color: #16a34a;\n}\n\n.readiness-item.warning .readiness-icon {\n  color: #d97706;\n}\n\n.readiness-item.missing .readiness-icon {\n  color: #dc2626;\n}\n\n.readiness-item > div {\n  display: grid;\n  gap: 6px;\n}\n\n.readiness-action {\n  display: block;\n  color: #334155;\n}\n\n.login-page {\n  min-height: 100vh;\n  display: grid;\n  place-items: center;\n  padding: 32px;\n  background:\n    linear-gradient(180deg, rgba(7, 193, 96, .08), rgba(7, 193, 96, 0) 42%),\n    #f6f8f7;\n}\n\n.login-shell {\n  width: min(980px, 100%);\n  min-height: 560px;\n  display: grid;\n  grid-template-columns: minmax(360px, 430px) minmax(0, 1fr);\n  overflow: hidden;\n  border: 1px solid #e5ebe7;\n  border-radius: 8px;\n  background: #fff;\n  box-shadow: 0 18px 50px rgba(17, 24, 39, .08);\n}\n\n.login-panel {\n  display: grid;\n  align-content: center;\n  gap: 24px;\n  padding: 44px;\n  background: #fff;\n}\n\n.login-brand {\n  display: flex;\n  align-items: center;\n  gap: 14px;\n}\n\n.login-logo {\n  width: 44px;\n  height: 44px;\n  display: grid;\n  place-items: center;\n  border-radius: 8px;\n  color: #fff;\n  background: #07c160;\n  box-shadow: 0 14px 28px rgba(7, 193, 96, .22);\n  font-size: 21px;\n  font-weight: 800;\n}\n\n.login-brand h3.ant-typography {\n  margin: 0 0 4px;\n}\n\n.login-form .ant-form-item-label > label {\n  color: #344054;\n  font-weight: 700;\n}\n\n.login-demo {\n  display: grid;\n  gap: 10px;\n  padding: 14px;\n  border: 1px solid #e3eaf0;\n  border-radius: 8px;\n  background: #f8fafc;\n}\n\n.login-hero {\n  position: relative;\n  display: grid;\n  align-content: center;\n  gap: 22px;\n  padding: 56px;\n  border-left: 1px solid #e5ebe7;\n  background: #f2fbf6;\n  color: #1f2329;\n}\n\n.login-hero .ant-typography,\n.login-hero h1.ant-typography {\n  color: #1f2329;\n}\n\n.login-hero h1.ant-typography {\n  max-width: 420px;\n  margin: 12px 0 10px;\n  font-size: 36px;\n  line-height: 1.18;\n}\n\n.login-hero .ant-typography-secondary,\n.login-hero .ant-typography {\n  color: #59636e;\n}\n\n.login-kicker {\n  width: fit-content;\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  padding: 7px 10px;\n  border: 1px solid #b9ebce;\n  border-radius: 8px;\n  background: #e9f8ef;\n  color: #058f49;\n  font-weight: 700;\n}\n\n.login-feature-grid {\n  display: grid;\n  grid-template-columns: 1fr;\n  gap: 10px;\n  margin-top: 22px;\n}\n\n.login-feature {\n  display: flex;\n  align-items: center;\n  gap: 9px;\n  padding: 11px 12px;\n  border: 1px solid #d9efe2;\n  border-radius: 8px;\n  background: #fff;\n  color: #2f3a45;\n}\n\n.login-feature .anticon {\n  color: #07c160;\n}\n\n.ant-card {\n  border-color: #e3eaf0;\n  box-shadow: 0 14px 34px rgba(15, 23, 42, .06);\n}\n\n.ant-card-head {\n  min-height: 54px;\n  border-bottom-color: #edf2f7;\n}\n\n.ant-card-head-title {\n  color: #17202a;\n  font-weight: 800;\n}\n\n.ant-table-wrapper .ant-table {\n  border-radius: 8px;\n  overflow: hidden;\n}\n\n.ant-table-thead > tr > th {\n  font-size: 13px;\n  font-weight: 800;\n}\n\n.ant-table-tbody > tr > td {\n  border-bottom-color: #eef2f6;\n}\n\n.student-table .ant-table-cell {\n  overflow-wrap: anywhere;\n}\n\n.student-table .ant-tag {\n  margin-inline-end: 0;\n  white-space: nowrap;\n}\n\n.ant-input,\n.ant-input-affix-wrapper,\n.ant-select-selector,\n.ant-input-number {\n  border-color: #dfe7ee !important;\n  box-shadow: none !important;\n}\n\n.ant-input:hover,\n.ant-input-affix-wrapper:hover,\n.ant-select-selector:hover,\n.ant-input-number:hover {\n  border-color: #b8c8d8 !important;\n}\n\n.ant-input:focus,\n.ant-input-affix-wrapper-focused,\n.ant-select-focused .ant-select-selector,\n.ant-input-number-focused {\n  border-color: #07c160 !important;\n  box-shadow: 0 0 0 3px rgba(7, 193, 96, .12) !important;\n}\n\n.ant-btn {\n  box-shadow: none;\n}\n\n.ant-btn-primary {\n  background: #07c160;\n  box-shadow: 0 12px 24px rgba(7, 193, 96, .2);\n}\n\n.ant-btn-primary:hover {\n  background: #06ad56 !important;\n}\n\n.ant-empty {\n  padding: 34px 16px;\n  border: 1px dashed #d5dee8;\n  border-radius: 8px;\n  background: #fbfdff;\n}\n\n@media (max-width: 900px) {\n  .app-shell,\n  .app-shell.ant-layout.ant-layout-has-sider {\n    display: block;\n  }\n\n  .app-shell.ant-layout-has-sider > .ant-layout {\n    flex: 0 0 100% !important;\n    min-width: 0 !important;\n    max-width: 100% !important;\n    width: 100% !important;\n  }\n\n  .app-sider {\n    position: relative;\n    flex: none !important;\n    width: 100% !important;\n    max-width: none !important;\n    min-width: 0 !important;\n    height: auto;\n    overflow: visible;\n  }\n\n  .app-sider .ant-layout-sider-children {\n    height: auto;\n  }\n\n  .app-sider .ant-menu {\n    overflow: visible;\n    padding-bottom: 18px;\n  }\n\n  .app-header {\n    height: auto;\n    line-height: normal;\n    min-height: auto;\n    align-items: flex-start;\n    padding: 18px;\n    gap: 14px;\n  }\n\n  .app-header > .ant-space {\n    flex-wrap: wrap;\n    line-height: normal;\n  }\n\n  .user-pill {\n    min-width: 0;\n  }\n\n  .page-heading {\n    display: grid;\n  }\n\n  .page-heading-actions {\n    justify-content: flex-start;\n  }\n\n  .student-stat-grid {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n\n  .schedule-grid {\n    grid-template-columns: 1fr;\n  }\n\n  .schedule-filterbar {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n\n  .schedule-filterbar.compact {\n    grid-template-columns: minmax(0, 1fr);\n  }\n\n  .schedule-outlook-shell,\n  .schedule-outlook-shell.is-collapsed {\n    grid-template-columns: 1fr;\n  }\n\n  .schedule-sidebar-rail {\n    position: static;\n    flex-direction: row;\n    justify-content: center;\n    padding: 8px;\n  }\n\n  .schedule-sidebar-rail > span {\n    writing-mode: horizontal-tb;\n    letter-spacing: normal;\n  }\n\n  .schedule-outlook-sidebar {\n    position: static;\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n\n  .schedule-outlook-sidebar .schedule-sidebar-section:last-child {\n    grid-column: 1 / -1;\n  }\n\n  .schedule-sidebar-filters {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n\n  .schedule-timeline-toolbar {\n    align-items: flex-start;\n  }\n\n  .schedule-timeline-toolbar > div:last-child {\n    text-align: left;\n  }\n\n  .schedule-summary-grid {\n    grid-template-columns: 1fr;\n  }\n\n  .week-board {\n    grid-template-columns: 1fr;\n    overflow-x: visible;\n  }\n\n  .week-day {\n    min-width: 0;\n  }\n\n  .dashboard-hero {\n    display: grid;\n    align-items: start;\n    min-height: 0;\n  }\n\n  .dashboard-hero h2.ant-typography {\n    font-size: 28px;\n  }\n\n  .login-shell {\n    grid-template-columns: 1fr;\n  }\n\n  .login-hero {\n    padding: 40px;\n  }\n}\n\n@media (max-width: 560px) {\n  .app-content {\n    padding: 16px;\n  }\n\n  .app-header {\n    display: grid;\n  }\n\n  .app-header-title {\n    font-size: 18px;\n  }\n\n  .dashboard-hero {\n    padding: 20px;\n  }\n\n  .dashboard-hero h2.ant-typography {\n    font-size: 24px;\n  }\n\n  .health-panel {\n    grid-template-columns: 1fr;\n    justify-items: start;\n  }\n\n  .schedule-outlook-sidebar,\n  .schedule-sidebar-filters {\n    grid-template-columns: 1fr;\n  }\n\n  .schedule-timeline-toolbar {\n    display: grid;\n  }\n\n  .todo-item {\n    grid-template-columns: 36px minmax(0, 1fr) 16px;\n    min-height: 72px;\n    padding: 12px;\n  }\n\n  .todo-icon {\n    width: 36px;\n    height: 36px;\n  }\n\n  .login-page {\n    padding: 16px;\n  }\n\n  .login-panel,\n  .login-hero {\n    padding: 24px;\n  }\n\n  .login-brand {\n    align-items: flex-start;\n  }\n\n  .login-hero h1.ant-typography {\n    font-size: 30px;\n  }\n\n  .login-feature-grid {\n    grid-template-columns: 1fr;\n  }\n\n  .card-list-grid {\n    grid-template-columns: 1fr;\n  }\n\n  .info-card-fields {\n    grid-template-columns: 1fr;\n  }\n\n  .schedule-slot-row {\n    grid-template-columns: 1fr 1fr;\n  }\n\n  .schedule-filterbar {\n    grid-template-columns: 1fr;\n  }\n\n  .week-day-header {\n    align-items: flex-start;\n  }\n}\n\n/* 月视图超出四条时的 \"+N\"。做成和条目同宽的一行，\n   点开是当天完整列表（Popover），和周视图的折叠块行为一致。 */\n.month-overflow-toggle {\n  width: 100%;\n  border: 1px dashed #cbd5e1;\n  border-radius: 4px;\n  background: transparent;\n  color: #475569;\n  padding: 2px 6px;\n  font-size: 12px;\n  cursor: pointer;\n  text-align: left;\n}\n\n.month-overflow-toggle:hover {\n  border-color: #94a3b8;\n  background: #f8fafc;\n}\n\n.month-overflow-list {\n  display: grid;\n  gap: 4px;\n  min-width: 240px;\n  max-width: 320px;\n}\n\n/* 重复课次标记。客户的 Outlook 里每个重复课次右下角都有这个图标。 */\n.schedule-recurrence-mark {\n  color: #64748b;\n  font-size: 12px;\n  flex: 0 0 auto;\n}\n\n.schedule-recurrence-mark.is-detached {\n  color: #b45309;\n}\n\n/* 课程块下沿的拉伸手柄。平时几乎不可见，悬浮到块上才显出来——\n   常驻一条实线会在密排的课表里变成视觉噪音。\n   高度 8px 是可点击的下限，再窄就抓不住。 */\n.schedule-timeline-resize {\n  position: absolute;\n  left: 0;\n  right: 0;\n  bottom: 0;\n  height: 8px;\n  cursor: ns-resize;\n  touch-action: none;\n}\n\n.schedule-timeline-resize::after {\n  content: '';\n  position: absolute;\n  left: 50%;\n  transform: translateX(-50%);\n  bottom: 2px;\n  width: 24px;\n  height: 2px;\n  border-radius: 2px;\n  background: var(--subject-color, #94a3b8);\n  opacity: 0;\n  transition: opacity 0.12s ease;\n}\n\n.schedule-timeline-block:hover .schedule-timeline-resize::after {\n  opacity: 0.7;\n}\n"]],"\n  ",["BODY",{},"\n    ",["DIV",{"id":"root"},["DIV",{"class":"page-loading"},"正在加载页面..."]],"\n    ","\n  \n\n\n"]],"viewport":{"width":1280,"height":720},"timestamp":1189.449,"wallTime":1788080340164,"collectionTime":0.5,"resourceOverrides":[],"isMainFrame":true}}
