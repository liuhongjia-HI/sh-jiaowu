.detail-page {
  min-height: 100vh;
  padding: 0 32rpx 54rpx;
  box-sizing: border-box;
  background: #f7f7f8;
  color: #17181b;
}

.detail-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 84rpx;
}

.detail-back,
.detail-share {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  color: #17181b;
  font-size: 42rpx;
  line-height: 1;
}

.detail-share {
  font-size: 31rpx;
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
}

.detail-share::after {
  border: 0;
}

.detail-topbar-title {
  max-width: 480rpx;
  overflow: hidden;
  color: #17181b;
  font-size: 28rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail-summary {
  position: relative;
  display: flex;
  min-height: 286rpx;
  overflow: hidden;
  padding: 28rpx 24rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #fff4ef 0%, #ffe4d7 100%);
  box-shadow: 0 12rpx 28rpx rgba(229, 108, 61, .09);
}

.detail-summary-copy {
  position: relative;
  z-index: 1;
  min-width: 0;
  flex: 1;
}

.detail-status {
  color: #ff5a1f;
  font-size: 22rpx;
  font-weight: 800;
}

.detail-status text {
  font-size: 19rpx;
}

.detail-title {
  max-width: 390rpx;
  margin-top: 20rpx;
  color: #17181b;
  font-size: 34rpx;
  font-weight: 850;
  line-height: 1.3;
}

.detail-meta {
  margin-top: 12rpx;
  color: #806f68;
  font-size: 21rpx;
  line-height: 1.45;
}

.detail-progress-row {
  display: flex;
  justify-content: space-between;
  width: 310rpx;
  margin-top: 30rpx;
  color: #61534d;
  font-size: 21rpx;
  font-weight: 700;
}

.detail-progress-row text:last-child {
  color: #ff5a1f;
}

.detail-progress {
  width: 310rpx;
  height: 8rpx;
  margin-top: 8rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, .75);
}

.detail-progress-bar {
  height: 100%;
  border-radius: 999rpx;
  background: #ff5a1f;
}

.detail-book-art {
  position: absolute;
  right: 22rpx;
  bottom: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 148rpx;
  height: 128rpx;
  border-radius: 42rpx 42rpx 34rpx 34rpx;
  background: rgba(255, 255, 255, .62);
  box-shadow: 0 16rpx 24rpx rgba(210, 112, 73, .12);
  font-size: 68rpx;
  transform: rotate(-8deg);
}

.detail-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 30rpx;
  margin-bottom: 14rpx;
}

.detail-section-title {
  color: #17181b;
  font-size: 29rpx;
  font-weight: 850;
}

.detail-section-title text {
  color: #a1a3aa;
  font-size: 21rpx;
  font-weight: 500;
}

.detail-section-link {
  flex: none;
  color: #8d9099;
  font-size: 21rpx;
}

.lesson-list {
  position: relative;
  padding: 4rpx 0;
}

.tag-filter { margin: 0 -4rpx 8rpx; white-space: nowrap; }
.tag-filter-inner { display: inline-flex; gap: 12rpx; padding: 2rpx 4rpx; }
.tag-chip { padding: 10rpx 16rpx; border-radius: 999rpx; background: #eceef2; color: #646873; font-size: 21rpx; }
.tag-chip.is-active { background: #ff5a1f; color: #fff; font-weight: 700; }

.lesson-row {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 10rpx 0 10rpx 18rpx;
}

.lesson-line {
  position: absolute;
  left: 24rpx;
  top: 0;
  bottom: 0;
  width: 2rpx;
  background: #e8e8eb;
}

.lesson-row:first-child .lesson-line {
  top: 50%;
}

.lesson-row:last-child .lesson-line {
  bottom: 50%;
}

.lesson-state {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #e7e8eb;
  color: #fff;
  font-size: 22rpx;
  font-weight: 800;
}

.lesson-copy {
  flex: 1;
  min-width: 0;
  padding-left: 20rpx;
}

.lesson-title,
.lesson-desc {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.lesson-title {
  color: #4d4f56;
  font-size: 25rpx;
  font-weight: 750;
}

.lesson-desc {
  margin-top: 5rpx;
  color: #a1a3aa;
  font-size: 20rpx;
}

.lesson-status {
  flex: none;
  color: #a1a3aa;
  font-size: 20rpx;
}

.lesson-row.is-done .lesson-state {
  background: #55c486;
}

.lesson-row.is-done .lesson-title,
.lesson-row.is-done .lesson-status {
  color: #55b77e;
}

.lesson-row.is-active {
  margin: 4rpx 0;
  padding-top: 14rpx;
  padding-bottom: 14rpx;
  border-radius: 18rpx;
  background: #fff4ef;
}

.lesson-row.is-active .lesson-state {
  background: #ff5a1f;
}

.lesson-row.is-active .lesson-title,
.lesson-row.is-active .lesson-status {
  color: #ff5a1f;
}

.material-head {
  margin-top: 28rpx;
}

.material-list {
  overflow: hidden;
  border: 1rpx solid #ededf0;
  border-radius: 20rpx;
  background: #fff;
}

.material-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 82rpx;
  padding: 12rpx 18rpx;
  border-top: 1rpx solid #f1f1f3;
}

.material-row:first-child {
  border-top: 0;
}

.material-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 48rpx;
  height: 58rpx;
  border-radius: 10rpx;
  background: #fff0e9;
  color: #ff5a1f;
  font-size: 17rpx;
  font-weight: 800;
}

.material-copy {
  flex: 1;
  min-width: 0;
}

.material-title,
.material-meta {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.material-title {
  color: #3a3b40;
  font-size: 24rpx;
  font-weight: 700;
}

.material-meta {
  margin-top: 5rpx;
  color: #a1a3aa;
  font-size: 19rpx;
}

.material-arrow {
  flex: none;
  color: #70737c;
  font-size: 28rpx;
}

.detail-empty-line {
  padding: 34rpx 20rpx;
  border-radius: 20rpx;
  background: #fff;
  color: #a1a3aa;
  font-size: 22rpx;
  text-align: center;
}

.detail-feedback {
  margin-top: 28rpx;
  padding: 0 4rpx 20rpx;
}

.detail-feedback .detail-section-head {
  margin-top: 0;
}

.detail-feedback-copy {
  color: #8d9099;
  font-size: 22rpx;
  line-height: 1.5;
}
