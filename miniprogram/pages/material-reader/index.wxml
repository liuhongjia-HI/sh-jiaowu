<view class="reader-page">
  <view wx:if="{{mode === 'loading'}}" class="reader-state">
    <view class="state-icon">⏳</view>
    <view class="state-title">正在打开课件</view>
    <view class="state-message">{{message}}</view>
  </view>

  <view wx:elif="{{mode === 'error'}}" class="reader-state">
    <view class="state-icon">📄</view>
    <view class="state-title">课件暂时未能打开</view>
    <view class="state-message">{{message}}</view>
    <button class="retry-button" bindtap="retry">重新加载</button>
  </view>

  <block wx:else>
    <view class="reader-summary">共 {{pageCount}} 页 · 向下滑动继续阅读</view>
    <view class="page-list">
      <view wx:for="{{pages}}" wx:key="page" class="page-card">
        <image
          class="page-image"
          src="{{item.path}}"
          mode="widthFix"
          data-index="{{index}}"
          bindtap="previewPage"
          show-menu-by-longpress="{{false}}"
        ></image>
        <view class="page-number">第 {{item.page}} / {{pageCount}} 页</view>
      </view>
    </view>
    <view wx:if="{{loadingMore}}" class="reader-footer">正在加载后续页面…</view>
    <view wx:elif="{{message}}" class="reader-footer error-footer">
      <view>{{message}}</view>
      <button class="retry-link" bindtap="retry">重试</button>
    </view>
    <view wx:elif="{{!hasMore && pages.length}}" class="reader-footer">课件已全部加载</view>
  </block>
</view>
