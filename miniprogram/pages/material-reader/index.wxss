page {
  background: #f6f7f9;
}

.reader-page {
  min-height: 100vh;
  padding: 24rpx 20rpx 48rpx;
  box-sizing: border-box;
}

.reader-summary {
  margin: 0 4rpx 20rpx;
  color: #8e929b;
  font-size: 24rpx;
  text-align: center;
}

.page-card {
  overflow: hidden;
  margin-bottom: 24rpx;
  border: 1rpx solid #eceef1;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(23, 28, 38, 0.06);
}

.page-image {
  display: block;
  width: 100%;
  background: #ffffff;
}

.page-number {
  padding: 16rpx 20rpx;
  border-top: 1rpx solid #f0f1f3;
  color: #9699a2;
  font-size: 22rpx;
  text-align: center;
}

.reader-state {
  display: flex;
  min-height: 62vh;
  padding: 48rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  text-align: center;
}

.state-icon {
  margin-bottom: 20rpx;
  font-size: 62rpx;
}

.state-title {
  color: #20232a;
  font-size: 32rpx;
  font-weight: 700;
}

.state-message {
  margin-top: 14rpx;
  color: #8e929b;
  font-size: 25rpx;
  line-height: 1.6;
}

.retry-button {
  margin-top: 32rpx;
  padding: 0 48rpx;
  border: 0;
  border-radius: 999rpx;
  background: #ff5a1f;
  color: #ffffff;
  font-size: 27rpx;
}

.retry-button::after,
.retry-link::after {
  border: 0;
}

.reader-footer {
  padding: 22rpx 0 10rpx;
  color: #9699a2;
  font-size: 24rpx;
  text-align: center;
}

.error-footer {
  color: #b56b52;
}

.retry-link {
  display: inline-block;
  margin: 12rpx 0 0;
  padding: 0 28rpx;
  border: 1rpx solid #ffd2c2;
  border-radius: 999rpx;
  background: #fff7f3;
  color: #ff5a1f;
  font-size: 24rpx;
  line-height: 56rpx;
}
