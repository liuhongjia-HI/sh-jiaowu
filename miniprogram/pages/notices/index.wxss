.notice-page {
  min-height: 100vh;
  padding: 24rpx 32rpx 156rpx;
  box-sizing: border-box;
  background: #f7f7f8;
  color: #17181b;
}

.notice-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 64rpx;
}

.notice-heading-title {
  color: #17181b;
  font-size: 38rpx;
  font-weight: 850;
  letter-spacing: -.5rpx;
}

.notice-heading-search {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
  color: #17181b;
  font-size: 40rpx;
}

.notice-student-context {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 22rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid #ffe0d2;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #fff7f2, #fff);
}

.notice-student-context-main {
  flex: 1;
  min-width: 0;
}

.notice-student-label {
  color: #a06f5b;
  font-size: 19rpx;
}

.notice-student-name {
  margin-top: 5rpx;
  color: #292a2e;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.45;
  overflow-wrap: anywhere;
}

.notice-student-name text {
  color: #777a83;
  font-size: 21rpx;
  font-weight: 500;
}

.notice-student-action {
  flex: none;
  margin-left: 16rpx;
  color: #ff5a1f;
  font-size: 20rpx;
}

.notice-tabs {
  display: flex;
  align-items: center;
  gap: 38rpx;
  height: 92rpx;
  border-bottom: 1rpx solid #ededf0;
}

.notice-tab {
  position: relative;
  height: 92rpx;
  color: #9b9da5;
  font-size: 25rpx;
  line-height: 92rpx;
}

.notice-tab.active {
  color: #ff5a1f;
  font-weight: 800;
}

.notice-tab.active::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 44rpx;
  height: 5rpx;
  border-radius: 5rpx;
  background: #ff5a1f;
  transform: translateX(-50%);
}

.notice-state {
  padding: 140rpx 0;
  color: #9b9da5;
  font-size: 24rpx;
  text-align: center;
}

.notice-empty {
  padding: 120rpx 20rpx 80rpx;
  text-align: center;
}

.notice-empty-art {
  position: relative;
  width: 260rpx;
  height: 180rpx;
  margin: 0 auto 30rpx;
}

.notice-empty-bell {
  position: absolute;
  left: 74rpx;
  top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 110rpx;
  height: 110rpx;
  border: 5rpx solid #ff6b37;
  border-radius: 58rpx 58rpx 34rpx 34rpx;
  color: #ff6b37;
  font-size: 60rpx;
  line-height: 1;
  transform: rotate(8deg);
}

.notice-empty-bell::after {
  content: "";
  position: absolute;
  left: 33rpx;
  bottom: -16rpx;
  width: 38rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #ff6b37;
}

.notice-empty-star {
  position: absolute;
  right: 34rpx;
  top: 34rpx;
  color: #ffb13b;
  font-size: 30rpx;
}

.notice-empty-title {
  color: #25262a;
  font-size: 29rpx;
  font-weight: 800;
}

.notice-empty-sub {
  margin-top: 12rpx;
  color: #9b9da5;
  font-size: 23rpx;
}

.notice-empty-button {
  width: 200rpx;
  height: 68rpx;
  margin: 34rpx auto 0;
  padding: 0;
  border: 1rpx solid #ff5a1f;
  border-radius: 34rpx;
  background: #fff;
  color: #ff5a1f;
  font-size: 23rpx;
  line-height: 68rpx;
}

.notice-empty-button::after {
  border: 0;
}

.notice-list {
  display: grid;
  gap: 14rpx;
  margin-top: 24rpx;
}

.notice-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 120rpx;
  padding: 18rpx;
  border: 1rpx solid #ededf0;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 8rpx 22rpx rgba(30, 31, 35, .035);
}

.notice-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background: #fff0e9;
  color: #ff5a1f;
  font-size: 26rpx;
  font-weight: 850;
}

.notice-icon-review {
  background: #eef4ff;
  color: #4a82e8;
}

.notice-body {
  flex: 1;
  min-width: 0;
}

.notice-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.notice-title,
.notice-target {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.notice-title {
  color: #292a2e;
  font-size: 25rpx;
  font-weight: 800;
}

.notice-status {
  flex: none;
  color: #45bd80;
  font-size: 19rpx;
}

.notice-summary {
  margin-top: 8rpx;
  color: #777a83;
  font-size: 22rpx;
  line-height: 1.5;
  overflow-wrap: anywhere;
  white-space: normal;
}

.notice-target {
  margin-top: 5rpx;
  color: #b0b2b9;
  font-size: 19rpx;
}

.notice-arrow {
  flex: none;
  color: #a1a3aa;
  font-size: 34rpx;
}
