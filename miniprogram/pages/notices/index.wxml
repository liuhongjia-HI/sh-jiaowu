<view class="notice-page">
  <view class="notice-heading">
    <view class="notice-heading-title">通知消息</view>
    <view class="notice-heading-search">⌕</view>
  </view>

  <view wx:if="{{linkedStudentText}}" class="notice-student-context" bindtap="goMe">
    <view class="notice-student-context-main">
      <view class="notice-student-label">{{studentCount > 1 ? "已关联学生" : "当前查看学生"}}</view>
      <view class="notice-student-name">{{linkedStudentText}}</view>
    </view>
    <view class="notice-student-action">{{studentCount > 1 ? "切换学生" : "查看个人中心"}} ›</view>
  </view>

  <view class="notice-tabs">
    <view wx:for="{{filters}}" wx:key="label" class="notice-tab {{item.className}}" data-filter="{{item.label}}" bindtap="changeFilter">{{item.label}}</view>
  </view>

  <view wx:if="{{loading}}" class="notice-state">正在加载通知...</view>
  <view wx:elif="{{visibleNotices.length === 0}}" class="notice-empty">
    <view class="notice-empty-art">
      <view class="notice-empty-bell">♧</view>
      <view class="notice-empty-star">✦</view>
    </view>
    <view class="notice-empty-title">{{notices.length === 0 ? "暂无新消息" : "这个分类还没有消息"}}</view>
    <view class="notice-empty-sub">{{notices.length === 0 ? "课程更新和学习提醒会显示在这里" : "切换到“全部”查看其他通知"}}</view>
    <button class="notice-empty-button" bindtap="goStudy">去学习中心</button>
  </view>
  <view wx:else class="notice-list">
    <view wx:for="{{visibleNotices}}" wx:key="id" class="notice-item" data-id="{{item.id}}" bindtap="goNotice">
      <view class="notice-icon notice-icon-{{item.iconClass}}">{{item.icon}}</view>
      <view class="notice-body">
        <view class="notice-title-row">
          <view class="notice-title">{{item.title}}</view>
          <view class="notice-status">{{item.status}}</view>
        </view>
        <view class="notice-summary">{{item.summary}}</view>
        <view class="notice-target">{{item.studentDisplay || item.scopeText}}</view>
      </view>
      <view class="notice-arrow">{{item.destinationPath ? '›' : ''}}</view>
    </view>
  </view>
</view>
