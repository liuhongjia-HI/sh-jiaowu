<view class="notice-page">
  <view class="notice-heading">
    <view class="notice-heading-title">通知消息</view>
    <view class="notice-heading-search">⌕</view>
  </view>

  <view class="notice-tabs">
    <view class="notice-tab active">全部</view>
    <view class="notice-tab">课程</view>
    <view class="notice-tab">作业</view>
    <view class="notice-tab">系统</view>
  </view>

  <view wx:if="{{loading}}" class="notice-state">正在加载通知...</view>
  <view wx:elif="{{notices.length === 0}}" class="notice-empty">
    <view class="notice-empty-art">
      <view class="notice-empty-bell">♧</view>
      <view class="notice-empty-star">✦</view>
    </view>
    <view class="notice-empty-title">暂无新消息</view>
    <view class="notice-empty-sub">课程更新和学习提醒会显示在这里</view>
    <button class="notice-empty-button" bindtap="goStudy">去学习中心</button>
  </view>
  <view wx:else class="notice-list">
    <view wx:for="{{notices}}" wx:key="id" class="notice-item">
      <view class="notice-icon notice-icon-{{item.iconClass}}">{{item.icon}}</view>
      <view class="notice-body">
        <view class="notice-title-row">
          <view class="notice-title">{{item.title}}</view>
          <view class="notice-status">{{item.status}}</view>
        </view>
        <view class="notice-summary">{{item.summary}}</view>
        <view class="notice-target">{{item.target}}</view>
      </view>
      <view class="notice-arrow">›</view>
    </view>
  </view>
</view>
