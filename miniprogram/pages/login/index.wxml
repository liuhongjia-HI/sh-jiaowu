<view class="hero">
  <view class="eyebrow">Welcome to Starline</view>
  <view class="hero-title">Link your phone to access your learning content</view>
</view>
<view class="section">
  <view class="card login-card">
    <view class="mascot">🐣</view>
    <view class="title">Start learning today</view>
    <view class="sub">Your phone number matches your teacher-activated student account to give you access to learning content.</view>
    <view class="form-line">
      <input value="{{form.studentName}}" data-field="studentName" bindinput="onInput" placeholder="Student name" />
    </view>
    <view class="form-line">
      <input value="{{form.schoolName}}" data-field="schoolName" bindinput="onInput" placeholder="School (optional)" />
    </view>
    <picker mode="selector" range="{{gradeLabels}}" value="{{gradeIndex}}" bindchange="onGradeChange">
      <view class="form-line picker-line">
        <view class="picker-value {{form.grade ? '' : 'placeholder'}}">{{gradeLabels[gradeIndex] || 'Select grade'}}</view>
      </view>
    </picker>
    <button class="button" open-type="getPhoneNumber" bindgetphonenumber="bindPhone" loading="{{binding}}" disabled="{{binding}}">Link Phone</button>
    <button class="button light secondary-button" bindtap="leaveLogin">Home</button>
    <view class="login-tip">Browse public content now. Your learning content will appear once your teacher activates access.</view>
  </view>
</view>
<view class="section">
  <view class="bubble">Your account is inactive. Contact your teacher.</view>
</view>
