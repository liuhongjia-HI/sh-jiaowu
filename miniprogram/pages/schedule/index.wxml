<view class="hero schedule-hero">
  <view class="eyebrow">Schedule</view>
  <view class="hero-title">My Schedule</view>
  <view class="hero-sub">View confirmed classes and update your availability</view>
</view>

<view wx:if="{{loading}}" class="empty">Loading schedule...</view>
<view wx:else>
  <view wx:if="{{loadError}}" class="section">
    <view class="notice">{{loadError}}</view>
  </view>

  <view class="section">
    <view class="section-headline">
      <view>
        <view class="section-kicker">Upcoming Classes</view>
        <view class="title">Next Class</view>
      </view>
      <view wx:if="{{nextClass}}" class="status-pill">{{nextClass.statusText}}</view>
    </view>
    <view wx:if="{{nextClass}}" class="next-card">
      <view class="time-primary">{{nextClass.timeText}}</view>
      <view class="class-name">{{nextClass.name}}</view>
      <view class="course-name">{{nextClass.courseName}}</view>
      <view class="class-meta">
        <view>Teacher: {{nextClass.teacherName}}</view>
        <view>Period: {{nextClass.periodText}}</view>
      </view>
    </view>
    <view wx:else class="empty-state">Confirmed classes will appear here once scheduled by the school office.</view>
  </view>

  <view class="section">
    <view class="section-headline">
      <view>
        <view class="section-kicker">Class Schedule</view>
        <view class="title">Confirmed Classes</view>
      </view>
      <view class="count-pill">{{classes.length}} lessons</view>
    </view>
    <view wx:if="{{classes.length === 0}}" class="empty-state">Confirmed classes will appear here once scheduled by the school office.</view>
    <view wx:else class="class-list">
      <view wx:for="{{classes}}" wx:key="id" class="class-row">
        <view class="class-row-main">
          <view class="class-row-time">{{item.timeText}}</view>
          <view class="class-row-title">{{item.name}}</view>
          <view class="class-row-sub">{{item.courseName}}</view>
        </view>
        <view class="class-row-meta">
          <view>{{item.teacherName}}</view>
          <view>{{item.statusText}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="availability-card">
      <view class="row">
        <view>
          <view class="title">Availability</view>
          <view class="sub">Submit your availability. The school office will confirm your class schedule.</view>
        </view>
        <view class="add-action" bindtap="addSlot">Add</view>
      </view>
      <view wx:if="{{availability.length === 0}}" class="empty-state compact">No availability submitted yet.</view>
      <view wx:for="{{availability}}" wx:key="id" class="slot-row">
        <picker mode="selector" range="{{weekOptions}}" range-key="label" bindchange="changeWeek" data-index="{{index}}">
          <view class="slot-cell">{{item.weekLabel}}</view>
        </picker>
        <input class="slot-input" value="{{item.startTime}}" placeholder="19:00" bindinput="changeStart" data-index="{{index}}" />
        <input class="slot-input" value="{{item.endTime}}" placeholder="20:30" bindinput="changeEnd" data-index="{{index}}" />
        <view class="slot-delete" bindtap="removeSlot" data-index="{{index}}">Delete</view>
      </view>
      <button class="button schedule-save" bindtap="saveAvailability">Save Availability</button>
    </view>
  </view>
</view>
