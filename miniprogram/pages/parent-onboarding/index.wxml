<view class="onboarding-page">
  <view class="onboarding-hero">
    <view class="brand-mark">S</view>
    <view class="eyebrow">Welcome to Starline</view>
    <view class="hero-title">Support your child's learning<br />step by step</view>
    <view class="hero-subtitle">Add a student to access courses, exercises, scores, and teacher feedback.</view>
    <view class="hero-illustration" aria-hidden="true">
      <view class="illustration-orbit"></view>
      <view class="illustration-card"></view>
      <view class="illustration-dot"></view>
    </view>
  </view>

  <view class="benefits-title">What You Can Access</view>
  <view class="benefit-list">
    <view wx:for="{{benefits}}" wx:key="title" class="benefit-card">
      <view class="benefit-icon benefit-icon-{{item.tone}}">{{item.icon}}</view>
      <view class="benefit-copy">
        <view class="benefit-title">{{item.title}}</view>
        <view class="benefit-summary">{{item.summary}}</view>
      </view>
    </view>
  </view>

  <view class="onboarding-card">
    <view class="card-title">Add a student when you are ready</view>
    <view class="card-subtitle">Enter the student's details and link your phone to access learning content.</view>
    <button class="primary-button" bindtap="goAddStudent">Add Student</button>
    <button class="secondary-button" bindtap="goBindStudent">Link Existing Student</button>
    <button class="skip-button" bindtap="skipForNow">Explore First</button>
  </view>

  <view class="help-copy">Need help? Contact your teacher or school office.</view>
</view>
