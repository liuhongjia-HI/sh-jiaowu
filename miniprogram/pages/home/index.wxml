<view class="home-page">
  <view class="home-top">
    <view class="home-greeting-row">
      <view>
        <view class="home-greeting">晚上好，学员 <text class="home-greeting-wave">👋</text></view>
        <view class="home-greeting-sub">坚持学习，遇见更好的自己</view>
      </view>
      <view class="home-search-mark">⌕</view>
    </view>
    <view class="search-panel">
      <view class="search-icon">⌕</view>
      <input class="search-input" value="{{keyword}}" placeholder="搜索推荐套餐、课程、资料" confirm-type="search" bindinput="changeKeyword" />
      <view wx:if="{{keyword}}" class="search-clear" bindtap="clearKeyword">清除</view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="empty">正在准备今天的学习内容...</view>
  <view wx:elif="{{!home}}" class="section">
    <view class="empty-card home-empty">
      <view class="title">先完成登录绑定</view>
      <view class="sub">{{emptyMessage}}</view>
      <button class="button" bindtap="goLogin">去登录绑定</button>
    </view>
  </view>
  <view wx:else>
    <view class="section" wx:if="{{promoBanners.length > 0}}">
      <swiper class="promo-banner-swiper" indicator-dots="{{promoBanners.length > 1}}" indicator-color="rgba(255,255,255,.45)" indicator-active-color="#fff" autoplay circular interval="4500">
        <swiper-item wx:for="{{promoBanners}}" wx:key="id">
          <image class="promo-banner-image" src="{{item.imageUrl}}" mode="aspectFill" data-id="{{item.id}}" bindtap="handlePromoBannerTap" />
        </swiper-item>
      </swiper>
    </view>
    <view class="section">
      <view class="starline-intro-banner" bindtap="goStarlineIntro">
        <view>
          <view class="starline-intro-tag">STARLINE</view>
          <view class="starline-intro-title">了解 Starline</view>
          <view class="starline-intro-sub">课程体系、学习服务与成长陪伴</view>
        </view>
        <view class="starline-intro-arrow">›</view>
      </view>
    </view>
    <view class="section">
      <view class="home-banner" bindtap="goStudyDetail">
        <view class="banner-copy">
          <view class="banner-year">{{bannerTag}}</view>
          <view class="banner-title">{{courseTitle}}</view>
          <view class="banner-sub">{{hasContent ? courseMeta : emptyMessage}}</view>
          <view class="banner-progress-row"><text>已学 {{progressPercent}}%</text><text>{{progressPercent >= 100 ? "已完成" : "继续保持"}}</text></view>
          <view class="progress banner-progress"><view class="progress-bar" style="width: {{progressPercent}}%;"></view></view>
          <view class="banner-action">{{hasContent ? "继续学习" : "查看学习中心"}}</view>
        </view>
        <view class="banner-visual">
          <view class="paper-card"></view>
          <view class="score-card">{{progressPercent}}%</view>
          <view class="phone-card"></view>
        </view>
      </view>
    </view>

    <view class="section shortcut-wrap">
      <view wx:for="{{shortcuts}}" wx:key="label" class="shortcut-item" data-action="{{item.action}}" bindtap="handleShortcut">
        <image class="shortcut-icon" src="{{item.icon}}" mode="aspectFit"></image>
        <view class="shortcut-label">{{item.label}}</view>
      </view>
    </view>

    <view class="section">
      <view class="status-strip">
        <view class="status-item">
          <view class="status-value">{{todoItems.length}}</view>
          <view class="status-label">今日待办</view>
        </view>
        <view class="status-item">
          <view class="status-value">{{materialCount}}</view>
          <view class="status-label">学习资料</view>
        </view>
        <view class="status-item">
          <view class="status-value">{{noticeCount}}</view>
          <view class="status-label">通知消息</view>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-head">
        <view>
          <view class="section-title tight">今日待办</view>
          <view class="section-sub">先处理关键学习安排</view>
        </view>
      </view>
      <view wx:if="{{todoItems.length === 0}}" class="empty-card home-empty">
        <view class="title">今天没有待处理事项</view>
        <view class="sub">课程、作业、批改反馈和提醒授权会集中显示在这里。</view>
      </view>
      <view wx:else class="todo-list">
        <view wx:for="{{todoItems}}" wx:key="id" class="todo-card {{item.className}}" data-type="{{item.type}}" data-path="{{item.path}}" bindtap="handleTodo">
          <view class="todo-icon">{{item.icon}}</view>
          <view class="todo-main">
            <view class="todo-top">
              <view class="todo-title">{{item.title}}</view>
              <view class="todo-status">{{item.status}}</view>
            </view>
            <view class="todo-summary">{{item.summary}}</view>
          </view>
          <view class="todo-action">{{item.actionText}}</view>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-head">
        <view>
          <view class="section-title tight">课后课堂反馈</view>
          <view class="section-sub">看清本节课表现和下一步</view>
        </view>
      </view>
      <view wx:if="{{feedbackItems.length === 0}}" class="empty-card home-empty">
        <view class="title">还没有课堂反馈</view>
        <view class="sub">老师完成批改后，会自动生成课后反馈。</view>
      </view>
      <view wx:else class="feedback-list">
        <view wx:for="{{feedbackItems}}" wx:key="id" class="feedback-card" data-id="{{item.relatedSubmissionId}}" bindtap="goFeedback">
          <view class="feedback-head">
            <view>
              <view class="feedback-course">{{item.courseName}}</view>
              <view class="feedback-title">{{item.lessonTitle}}</view>
            </view>
            <view class="feedback-score">{{item.score}}分</view>
          </view>
          <view class="feedback-text">{{item.performance}}</view>
          <view class="feedback-note">老师：{{item.teacherName}}</view>
          <view class="feedback-focus">重点：{{item.focus}}</view>
          <view class="feedback-next">下一步：{{item.nextStep}}</view>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-head">
        <view>
          <view class="section-title tight">推荐套餐</view>
          <view class="section-sub">{{keyword ? "按搜索结果展示" : "发现还未开通的课程和学习资料"}}</view>
        </view>
      </view>

      <view wx:if="{{recommendationsLoading}}" class="empty-card home-empty">
        <view class="sub">正在为你寻找合适的学习套餐...</view>
      </view>
      <view wx:elif="{{recommendationError}}" class="empty-card home-empty">
        <view class="title">推荐套餐加载失败</view>
        <view class="sub">{{recommendationError}}</view>
        <button class="button light" bindtap="loadRecommendations">重新加载</button>
      </view>
      <view wx:elif="{{recommendations.length === 0}}" class="empty-card home-empty">
        <view class="title">暂时没有合适的推荐套餐</view>
        <view class="sub">老师发布同年级、同学期的课程或讲义套餐后，会显示在这里。</view>
      </view>
      <view wx:elif="{{visibleRecommendations.length === 0}}" class="empty-card home-empty">
        <view class="title">没有找到相关套餐</view>
        <view class="sub">换个关键词，或清除搜索后查看全部推荐。</view>
        <button class="button light" bindtap="clearKeyword">清除搜索</button>
      </view>
      <view wx:else class="recommendation-list">
        <view wx:for="{{visibleRecommendations}}" wx:key="packageId" class="recommendation-card" data-package-id="{{item.packageId}}" bindtap="showRecommendation">
          <view class="content-main">
            <view class="content-top">
              <view class="content-type">{{item.recommendationReason}}</view>
              <view class="content-tag">{{item.subject}}</view>
            </view>
            <view class="content-title">{{item.packageName}}</view>
            <view class="content-meta">{{item.grade}} · {{item.semester}} · {{item.courseCount}} 门课程 · {{item.materialCount}} 份资料</view>
            <view wx:if="{{item.contentSamples.length}}" class="recommendation-samples">{{item.contentSampleText}}</view>
            <view wx:if="{{item.summary}}" class="recommendation-summary">{{item.summary}}</view>
            <button class="recommendation-action" data-name="{{item.packageName}}" catchtap="contactTeacher">联系老师开通</button>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
