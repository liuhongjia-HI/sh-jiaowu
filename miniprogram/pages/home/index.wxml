<view class="home-page">
  <view class="home-top">
    <view class="home-title-row">
      <view class="home-page-title">Home</view>
    </view>
    <view class="search-panel">
      <view class="search-icon">⌕</view>
      <input class="search-input" value="{{keyword}}" placeholder="Search courses or materials" confirm-type="search" bindinput="changeKeyword" />
      <view wx:if="{{keyword}}" class="search-clear" bindtap="clearKeyword">Clear</view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="empty">Preparing your learning content...</view>
  <view wx:elif="{{!home}}" class="section">
    <view class="empty-card home-empty">
      <view class="title">Failed to load learning content</view>
      <view class="sub">{{error || 'Check your network and try again.'}}</view>
      <button class="button" bindtap="loadHome">Reload</button>
    </view>
  </view>
  <view wx:else>
    <view class="section" wx:if="{{visitorMode}}">
      <view class="empty-card home-empty">
        <view class="title">Add a student to access learning content</view>
        <view class="sub">Explore public content now and link your phone later.</view>
        <button class="button" bindtap="goAddStudent">Add Student</button>
      </view>
    </view>
    <view class="section" wx:if="{{promoBanners.length > 0}}">
      <swiper class="promo-banner-swiper" indicator-dots="{{promoBanners.length > 1}}" indicator-color="rgba(255,255,255,.45)" indicator-active-color="#fff" autoplay circular interval="4500">
        <swiper-item wx:for="{{promoBanners}}" wx:key="id">
          <image class="promo-banner-image" src="{{item.imageUrl}}" mode="aspectFill" data-id="{{item.id}}" bindtap="handlePromoBannerTap" />
        </swiper-item>
      </swiper>
    </view>
    <!-- 课程入口统一由“今日待办”和学习页承载，避免与待办任务重复展示。 -->
    <view class="section shortcut-wrap">
      <view wx:for="{{shortcuts}}" wx:key="label" class="shortcut-item" data-action="{{item.action}}" bindtap="handleShortcut">
        <image class="shortcut-icon" src="{{item.icon}}" mode="aspectFit"></image>
        <view class="shortcut-label">{{item.label}}</view>
      </view>
    </view>

    <view class="section">
      <view class="status-strip">
        <view class="status-item" data-action="tasks" bindtap="handleShortcut">
          <view class="status-value">{{todoItems.length}}</view>
          <view class="status-label">To Do</view>
        </view>
        <view class="status-item" data-action="study" bindtap="handleShortcut">
          <view class="status-value">{{openedSubjectCount}}</view>
          <view class="status-label">Course</view>
        </view>
        <view class="status-item" data-action="notices" bindtap="handleShortcut">
          <view class="status-value">{{noticeCount}}</view>
          <view class="status-label">Message</view>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-head">
        <view>
          <view class="section-title tight">To Do</view>
          <view class="section-sub">Complete your important tasks first</view>
        </view>
      </view>
      <view wx:if="{{todoItems.length === 0}}" class="empty-card home-empty">
        <view class="title">No tasks for today</view>
        <view class="sub">Courses, exercises, and feedback will appear here.</view>
      </view>
      <view wx:else class="todo-list {{todoRotationState}}">
        <view wx:for="{{visibleTodoGroup}}" wx:key="id" class="todo-card {{item.className}}" data-type="{{item.type}}" data-path="{{item.path}}" bindtap="handleTodo">
          <view class="todo-icon">{{item.icon}}</view>
          <view class="todo-main">
            <view class="todo-top">
              <view class="todo-title">{{item.title}}</view>
              <view wx:if="{{item.status}}" class="todo-status">{{item.status}}</view>
            </view>
            <view wx:if="{{item.summary}}" class="todo-summary">{{item.summary}}</view>
          </view>
          <view class="todo-action">{{item.actionText}} ›</view>
        </view>
      </view>
    </view>

    <view class="section" wx:if="{{showSubscribePrompt}}">
      <view class="subscribe-prompt" bindtap="requestLearningSubscribe">
        <view class="subscribe-prompt-icon">🔔</view>
        <view class="subscribe-prompt-main">
          <view class="subscribe-prompt-title">{{subscriptionReminder.title || 'Reminder'}}</view>
          <view class="subscribe-prompt-summary">{{subscriptionReminder.summary || 'Get reminders for classes, homework, and review results.'}}</view>
        </view>
        <view class="subscribe-prompt-action">{{subscriptionReminder.actionText || 'Enable Reminders'}} ›</view>
      </view>
    </view>

    <view class="section">
      <view class="section-head">
        <view>
          <view class="section-title tight">Comment</view>
          <view class="section-sub">Review class performance and next steps</view>
        </view>
      </view>
      <view wx:if="{{feedbackItems.length === 0}}" class="empty-card home-empty">
        <view class="title">No class feedback yet</view>
        <view class="sub">Feedback will appear after your teacher reviews your work.</view>
      </view>
      <view wx:else class="feedback-list">
        <view wx:for="{{feedbackItems}}" wx:key="id" class="feedback-card" data-id="{{item.relatedSubmissionId}}" bindtap="goFeedback">
          <view class="feedback-head">
            <view>
              <view class="feedback-course">{{item.courseName}}</view>
              <view class="feedback-title">{{item.lessonTitle}}</view>
            </view>
            <view class="feedback-score">{{item.score}} pts</view>
          </view>
          <view class="feedback-text">{{item.performance}}</view>
          <view class="feedback-note">Teacher: {{item.teacherName}}</view>
          <view class="feedback-focus">Focus: {{item.focus}}</view>
          <view class="feedback-next">Next steps: {{item.nextStep}}</view>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-head">
        <view>
          <view class="section-title tight">Recommendation</view>
          <view class="section-sub">{{keyword ? "Recommendations matching your search" : "Explore subjects for your grade"}}</view>
        </view>
      </view>

      <view wx:if="{{recommendationsLoading}}" class="empty-card home-empty">
        <view class="sub">Finding courses...</view>
      </view>
      <view wx:elif="{{recommendationError}}" class="empty-card home-empty">
        <view class="title">Failed to load recommendations</view>
        <view class="sub">{{recommendationError}}</view>
        <button class="button light" bindtap="loadRecommendations">Reload</button>
      </view>
      <view wx:elif="{{recommendations.length === 0}}" class="empty-card home-empty">
        <view class="title">No recommended subjects for this grade yet</view>
        <view class="sub">Subjects you can unlock will appear here.</view>
      </view>
      <view wx:elif="{{visibleRecommendations.length === 0}}" class="empty-card home-empty">
        <view class="title">No matching courses</view>
        <view class="sub">Try another keyword or clear your search to see all recommendations.</view>
        <button class="button light" bindtap="clearKeyword">Clear Search</button>
      </view>
      <view wx:else class="recommendation-list">
        <view wx:for="{{displayedRecommendations}}" wx:key="subject" class="recommendation-card" data-subject="{{item.subject}}" bindtap="showRecommendation">
          <view class="content-main">
            <view class="content-top">
              <view class="content-type">{{item.recommendationReasonLabel}}</view>
              <view class="content-tag">{{item.displayName || item.subject}}</view>
            </view>
            <view class="content-title">{{item.displayName || item.subject}}</view>
            <view class="content-meta">{{item.gradeLabel}} · {{item.courseCount}} courses · {{item.materialCount}} materials</view>
            <view class="content-meta">{{item.questionCount}} questions · {{item.homeworkCount}} exercises</view>
            <view class="recommendation-summary">Teacher: {{item.teacherName || "Not assigned"}}</view>
            <view wx:if="{{item.teacherIntroLabel}}" class="recommendation-summary">{{item.teacherIntroLabel}}</view>
            <button class="recommendation-action" data-name="{{item.subject}}" catchtap="contactTeacher">Contact Teacher</button>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
<view wx:if="{{launchVisible && launchCampaign}}" class="launch-mask">
  <view class="launch-dialog" catchtap="noop">
    <view class="launch-close" bindtap="closeLaunchCampaign">×</view>
    <image wx:if="{{launchCampaign.imageUrl}}" class="launch-image" src="{{launchCampaign.imageUrl}}" mode="aspectFill" />
    <view class="launch-title">{{launchCampaign.title}}</view>
    <view class="launch-message">{{launchCampaign.message}}</view>
    <view wx:if="{{launchCampaign.subMessage}}" class="launch-sub">{{launchCampaign.subMessage}}</view>
    <picker wx:if="{{launchCampaign.timeOptions.length}}" mode="selector" range="{{launchCampaign.timeOptions}}" bindchange="chooseLaunchTime"><view class="launch-picker">{{launchTimeOption || 'Select class time'}}</view></picker>
    <button class="button launch-action" bindtap="submitLaunchCampaign">{{launchCampaign.primaryActionText}}</button>
  </view>
</view>
