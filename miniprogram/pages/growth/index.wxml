<view class="hero">
  <view class="eyebrow">Progress</view>
  <view class="hero-title">Track Every Step Forward 🌱</view>
</view>
<view wx:if="{{loading}}" class="empty">Loading progress...</view>
<view wx:elif="{{records.length === 0}}" class="section">
  <view class="empty-card">
    <view class="title">No progress records yet</view>
    <view class="sub">{{emptyMessage}}</view>
  </view>
</view>
<view wx:else class="section">
  <view wx:for="{{records}}" wx:key="id" class="card">
    <view class="row">
      <view class="title small-title">{{item.type}} · {{item.title}}</view>
      <view wx:if="{{item.score && item.fullScore}}" class="badge">{{item.score}}/{{item.fullScore}} pts</view>
      <view wx:elif="{{item.score}}" class="badge">{{item.score}} pts</view>
      <view wx:else class="tag">{{item.status}}</view>
    </view>
    <rich-text class="sub rich-text" nodes="{{item.description}}"></rich-text>
    <view class="muted">{{item.occurredAt}}</view>
  </view>
</view>
