<view class="study-page">
  <view class="study-heading">
    <view class="study-heading-title">Learning Center</view>
    <view class="study-heading-sub">Courses, materials, and exercises</view>
  </view>

  <view class="study-search">
    <view class="study-search-icon">⌕</view>
    <input class="study-search-input" value="{{keyword}}" placeholder="Search courses or materials" bindinput="changeKeyword" confirm-type="search" />
  </view>

  <view class="study-tabs">
    <view wx:for="{{filters}}" wx:key="key" class="study-tab {{item.className}}" data-filter="{{item.key}}" bindtap="changeFilter">{{item.label}}</view>
  </view>

  <view wx:if="{{loading}}" class="study-state">Loading learning content...</view>
  <view wx:elif="{{authRequired}}" class="study-section">
    <view class="study-empty">
      <view class="study-empty-art">✨</view>
      <view class="study-empty-title">Bind a student to start</view>
      <view class="study-empty-sub">Browse learning content first. After binding a student, you can view teacher-prepared content, progress, and feedback.</view>
      <button class="button" bindtap="goLogin">Bind student</button>
    </view>
  </view>
  <view wx:elif="{{courses.length === 0}}" class="study-section">
    <view class="study-empty">
      <view class="study-empty-art">📚</view>
      <view class="study-empty-title">No learning content yet</view>
      <view class="study-empty-sub">{{emptyMessage}}</view>
    </view>
  </view>
  <view wx:elif="{{visibleCourses.length === 0}}" class="study-section">
    <view class="study-empty">
      <view class="study-empty-art">⌕</view>
      <view class="study-empty-title">No matching content</view>
      <view class="study-empty-sub">Try another keyword, or switch back to All.</view>
    </view>
  </view>
  <view wx:else class="study-section course-list">
    <view wx:if="{{openedCourseCount}}" class="course-list-heading">
      <view class="course-list-title">Unlocked courses</view>
      <view class="course-list-count">{{openedCourseCount}} ready to learn</view>
    </view>
    <block wx:for="{{visibleCourses}}" wx:key="id">
      <view wx:if="{{item.canOpen}}" class="course-card-hit-area" bindtap="goDetail" data-id="{{item.entryCourseId}}" data-message="{{item.isPreparing ? 'Content is being prepared' : 'Unlock to access all content'}}">
        <template is="course-card" data="{{item: item, index: index}}" />
      </view>
      <view wx:else class="course-card-hit-area">
        <template is="course-card" data="{{item: item, index: index}}" />
      </view>
    </block>
  </view>

  <view wx:if="{{materials.length}}" class="study-section study-material-hint">
    <view class="study-section-title">Materials</view>
    <view class="study-section-link">{{materials.length}} ready for you</view>
  </view>
</view>

<template name="course-card">
  <view class="course-card {{item.cardClass}} {{item.isLocked ? 'course-locked' : ''}}">
    <view class="course-cover course-cover-{{index}}">
      <image wx:if="{{item.imageUrl}}" class="course-cover-image" src="{{item.imageUrl}}" mode="aspectFill" />
      <view class="course-cover-glow"></view>
      <view class="course-cover-emoji">{{item.coverIcon}}</view>
    </view>
    <view class="course-content">
      <view class="course-title-row">
        <view class="course-title">{{item.displayName || item.name}}</view>
        <view class="course-status {{item.isLocked ? 'course-status-locked' : 'course-status-new'}}">{{item.accessLabel || (item.isNew ? '新开通' : item.status)}}</view>
      </view>
      <view class="course-meta">{{item.grade || "学习内容"}} · {{item.displaySubject || item.subject || "综合学习"}}</view>
      <view wx:if="{{item.newCourseText}}" class="course-new-time">{{item.newCourseText}}</view>
      <view class="course-code">{{item.materialNum || 0}} materials · {{item.homeworkNum || 0}} exercises</view>
      <view wx:if="{{!item.isLocked}}" class="course-progress-row">
        <text>{{item.progress}}% learned</text>
        <text>{{item.progress >= 100 ? "Completed" : "Continue"}}</text>
      </view>
      <view wx:if="{{!item.isLocked}}" class="course-progress"><view class="course-progress-bar" style="width: {{item.progress}}%;"></view></view>
      <view wx:if="{{item.canOpen}}" class="course-action">{{item.isPreview ? 'Try' : 'Start'}} <text class="course-action-arrow">›</text></view>
      <view wx:else class="course-action course-action-disabled">{{item.accessLabel || '内容准备中'}}</view>
    </view>
  </view>
</template>
