<view class="global-watermark-layer" aria-hidden="true">
  <view wx:for="{{watermarkTexts}}" wx:key="index" class="global-watermark">{{item}}</view>
</view>
<view class="hero">
  <view class="eyebrow">{{taskTitle}}</view>
  <view class="hero-title">{{rewardText}}</view>
  <view class="badge">{{deadlineText}}</view>
</view>
<view class="section secure-section">
  <view class="security-notice">{{securityNotice}}</view>
  <block wx:for="{{questions}}" wx:key="id" wx:for-item="question" wx:for-index="qindex">
    <view class="card">
      <view class="badge">{{question.type === 'single' ? 'Single Choice' : question.type === 'multiple' ? 'Multiple Choice' : question.type === 'judge' ? 'True or False' : question.type === 'fill' ? 'Fill in the Blank' : 'Short Answer'}}</view>
      <view class="title question-title">{{question.index}}.</view>
      <rich-text class="question-stem rich-text" nodes="{{question.stem}}"></rich-text>
      <block wx:if="{{question.type === 'single' || question.type === 'multiple' || question.type === 'judge'}}">
        <view wx:for="{{question.options}}" wx:key="value" wx:for-item="option" class="option {{option.className}}" data-qindex="{{qindex}}" data-value="{{option.value}}" bindtap="chooseOption">{{option.label}}</view>
      </block>
      <input wx:elif="{{question.type === 'fill'}}" value="{{question.text}}" placeholder="Enter your answer" data-qindex="{{qindex}}" bindinput="changeAnswer" />
      <textarea wx:else value="{{question.text}}" placeholder="Enter your answer here" data-qindex="{{qindex}}" bindinput="changeAnswer" />
    </view>
  </block>
  <view class="button-row">
    <button wx:if="{{downloadUrl}}" class="button light" bindtap="downloadHomework">Download Exercise</button>
    <button class="button light" bindtap="toggleFavorite">{{favorited ? 'Added to favorites ✓' : 'Favorite ♡'}}</button>
    <button class="button light" disabled="{{isOverdue}}" bindtap="saveDraft">Save Draft</button>
    <button class="button" disabled="{{isOverdue}}" loading="{{saving}}" bindtap="submit">{{isOverdue ? 'Closed' : 'Submit'}}</button>
  </view>
</view>
