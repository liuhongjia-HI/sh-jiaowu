<view class="global-watermark-layer" aria-hidden="true">
  <view wx:for="{{watermarkTexts}}" wx:key="index" class="global-watermark">{{item}}</view>
</view>
<view class="hero">
  <view class="eyebrow">{{taskTitle}}</view>
  <view class="hero-title">{{rewardText}}</view>
  <view class="badge">{{deadlineText}}</view>
</view>
<view class="section secure-section">
  <view class="security-notice">{{securityNotice}}</view>
  <block wx:for="{{questions}}" wx:key="id" wx:for-item="question" wx:for-index="qindex">
    <view class="card">
      <view class="badge">{{question.type === 'single' ? '单选题' : question.type === 'multiple' ? '多选题' : question.type === 'judge' ? '判断题' : question.type === 'fill' ? '填空题' : '简答题'}}</view>
      <view class="title question-title">{{question.index}}.</view>
      <rich-text class="question-stem rich-text" nodes="{{question.stem}}"></rich-text>
      <block wx:if="{{question.type === 'single' || question.type === 'multiple' || question.type === 'judge'}}">
        <view wx:for="{{question.options}}" wx:key="value" wx:for-item="option" class="option {{option.className}}" data-qindex="{{qindex}}" data-value="{{option.value}}" bindtap="chooseOption">{{option.label}}</view>
      </block>
      <input wx:elif="{{question.type === 'fill'}}" value="{{question.text}}" placeholder="填写答案" data-qindex="{{qindex}}" bindinput="changeAnswer" />
      <textarea wx:else value="{{question.text}}" placeholder="在这里填写你的答案" data-qindex="{{qindex}}" bindinput="changeAnswer" />
    </view>
  </block>
  <view class="button-row">
    <button wx:if="{{downloadUrl}}" class="button light" bindtap="downloadHomework">下载习题</button>
    <button class="button light" bindtap="toggleFavorite">{{favorited ? '已收藏 ✓' : '收藏练习 ♡'}}</button>
    <button class="button light" disabled="{{isOverdue}}" bindtap="saveDraft">保存草稿</button>
    <button class="button" disabled="{{isOverdue}}" loading="{{saving}}" bindtap="submit">{{isOverdue ? '已截止' : '我做完啦'}}</button>
  </view>
</view>
