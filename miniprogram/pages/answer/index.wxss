textarea {
  width: 100%;
  min-height: 180rpx;
  border-radius: 24rpx;
  background: #fffaf6;
  border: 1rpx solid #f1dfd4;
  padding: 20rpx;
  box-sizing: border-box;
  margin-top: 18rpx;
}

.secure-section {
  position: relative;
  overflow: hidden;
}

.global-watermark-layer {
  position: fixed;
  inset: 0;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  grid-auto-rows: minmax(150rpx, 1fr);
  gap: 70rpx 16rpx;
  padding: 80rpx 0;
  box-sizing: border-box;
  pointer-events: none;
  z-index: 20;
}

.global-watermark {
  transform: rotate(-24deg);
  opacity: .09;
  color: #5d4d45;
  font-size: 24rpx;
  font-weight: 800;
  text-align: center;
  white-space: nowrap;
}

.security-notice {
  position: relative;
  z-index: 2;
  margin-bottom: 18rpx;
  padding: 18rpx 22rpx;
  border-radius: 22rpx;
  background: #fff2ea;
  color: #9a5b3d;
  font-size: 24rpx;
  line-height: 1.5;
}

.secure-section .card,
.secure-section .button-row {
  position: relative;
  z-index: 2;
}

.question-title {
  margin-top: 14rpx;
}

.question-stem {
  display: block;
  margin-top: 10rpx;
  color: #2b2522;
  font-size: 30rpx;
  font-weight: 750;
  line-height: 1.55;
}

.option {
  margin-top: 18rpx;
  padding: 22rpx;
  border: 1rpx solid #f1dfd4;
  border-radius: 22rpx;
  background: #fffaf6;
  color: #5d4d45;
  font-size: 26rpx;
  line-height: 1.45;
}

.option.active {
  border-color: #ff9f7f;
  background: #fff1e9;
  color: #d96f45;
  font-weight: 800;
}
