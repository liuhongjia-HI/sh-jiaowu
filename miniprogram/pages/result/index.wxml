<view class="hero">
  <view class="eyebrow">{{taskTitle}}</view>
  <view class="hero-title">{{resultTitle}}</view>
  <view wx:if="{{objectiveText}}" class="badge">{{objectiveText}}</view>
  <view wx:if="{{rewardText}}" class="badge">{{rewardText}}</view>
</view>
<view class="section">
  <view wx:if="{{rewardText}}" class="card reward">
    <view class="title">Rewards Earned</view>
    <view class="badges">
      <view class="badge">{{rewardText}}</view>
      <view class="badge">🔓 Next lesson unlocked</view>
    </view>
    <view class="sub">Keep learning to unlock more badges.</view>
  </view>
  <view class="card blue">
    <view class="title">Teacher Feedback</view>
    <rich-text class="sub rich-text" nodes="{{teacherCommentNodes}}"></rich-text>
  </view>
  <view class="button-row">
    <button class="button light" bindtap="goBack">Back to Exercises</button>
    <button class="button" bindtap="goStudy">Continue Learning</button>
  </view>
</view>
