<view class="hero">
  <view class="eyebrow">资料预览</view>
  <view class="hero-title">{{pageTitle}}</view>
  <view class="badge">{{material.downloadUrl ? '开放期内可下载' : '资料仅在线查看'}}</view>
</view>
<view class="section">
  <view class="card">
    <view class="bubble">小提示：先看课程讲义里的例子，再去做小挑战会更轻松。</view>
    <view class="row preview-meta">
      <view class="sub">学习记录已保存</view>
      <view class="sub">带专属水印</view>
    </view>
    <view class="security-notice">{{securityNotice}}</view>

    <view wx:if="{{recordingWarning}}" class="recording-warning">
      <view class="recording-guard-icon">⚠️</view>
      <view>
        <view class="recording-guard-text">检测到系统录屏</view>
        <view class="recording-guard-sub">课件已带专属水印，请勿录制或外传。</view>
      </view>
    </view>

    <view wx:if="{{previewMode === 'image'}}" class="paged-preview">
      <view wx:for="{{pageImages}}" wx:key="index" class="page-wrap">
        <image wx:if="{{item.status === 'ready'}}" class="page-image" src="{{item.path}}" mode="widthFix" show-menu-by-longpress="{{false}}"></image>
        <view wx:if="{{item.status === 'ready'}}" class="watermark-layer">
          <view wx:for="{{watermarkTexts}}" wx:for-item="mark" wx:key="mark" class="watermark">{{mark}}</view>
        </view>
        <view wx:elif="{{item.status === 'error'}}" class="page-error">
          <view>第 {{item.index}} 页加载失败</view>
          <view class="page-error-message">{{item.error}}</view>
          <button class="button light page-retry" data-page="{{item.index}}" bindtap="retryPage">重新加载</button>
        </view>
        <view wx:else class="page-placeholder">正在加载第 {{item.index}} 页…</view>
        <view class="page-index">第 {{item.index}}/{{pageCount}} 页</view>
      </view>
      <view wx:if="{{pagesLoading}}" class="page-loading">正在加载第 {{loadedPageCount}}/{{pageCount}} 页…</view>
    </view>

    <view wx:elif="{{previewMode === 'pdf'}}" class="paper">
      <view class="watermark-layer">
        <view wx:for="{{watermarkTexts}}" wx:key="index" class="watermark">{{item}}</view>
      </view>
      <view class="paper-title">{{paperTitle}}</view>
      <view class="paper-line"></view>
      <view class="paper-line short"></view>
      <view class="paper-block">📘</view>
      <view class="paper-line"></view>
      <view class="paper-line tiny"></view>
    </view>

    <view wx:elif="{{previewMode === 'unavailable'}}" class="preview-unavailable">
      <view class="preview-unavailable-icon">📄</view>
      <view class="preview-unavailable-title">课件暂时无法打开</view>
      <view class="preview-unavailable-message">{{previewMessage}}</view>
      <button class="button light preview-retry" bindtap="retryPreview">重新检查</button>
    </view>

    <view class="badges">
      <view class="badge">{{readText}}</view>
      <view class="badge">距离小徽章还差一步</view>
    </view>
    <view class="button-row">
      <button class="button light" bindtap="toggleFavorite">{{favorited ? '已收藏 ✓' : '收藏资料 ♡'}}</button>
      <button wx:if="{{material.downloadUrl}}" class="button light" bindtap="downloadMaterial">下载课件</button>
      <button wx:if="{{previewMode === 'pdf'}}" class="button light" bindtap="openSecurePreview">安全预览</button>
      <button class="button" bindtap="goAnswer">去做小挑战</button>
    </view>
  </view>
</view>
