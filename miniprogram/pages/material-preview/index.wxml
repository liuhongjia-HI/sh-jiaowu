<view class="material-preview-page">
  <view wx:if="{{contentMode === 'material'}}" class="global-watermark-layer" aria-hidden="true">
    <view wx:for="{{watermarkTexts}}" wx:key="index" class="global-watermark">{{item}}</view>
  </view>

  <view class="preview-header">
    <view class="preview-title">{{displayTitle}}</view>
    <view wx:if="{{contentMode === 'material' || contentMode === 'homework'}}" class="preview-meta-line">
      <text class="preview-kicker">{{contentTagLabel || activeTagLabel}}</text>
      <text wx:if="{{contentMode === 'material' && materialCode}}" class="preview-code">{{materialCode}}</text>
    </view>
  </view>

  <scroll-view class="lesson-tag-filter" scroll-x="true" enable-flex="true" show-scrollbar="{{false}}">
    <view class="lesson-tag-filter-inner">
      <view wx:for="{{tags}}" wx:key="code" class="lesson-tag {{activeTag === item.code ? 'is-active' : ''}} {{item.count ? '' : 'is-empty'}}" data-code="{{item.code}}" bindtap="selectTag">
        <text class="lesson-tag-label">{{item.shortLabel}}</text>
        <text wx:if="{{item.count}}" class="lesson-tag-count">{{item.count}}</text>
      </view>
    </view>
  </scroll-view>

  <view class="section">
    <view wx:if="{{(contentMode === 'material' || contentMode === 'homework') && tagItems.length}}" class="back-to-list" bindtap="backToList">‹ Back</view>
    <block wx:if="{{contentMode === 'material'}}">
      <view wx:if="{{recordingWarning}}" class="recording-warning">
        <view class="recording-guard-icon">⚠️</view>
        <view>
          <view class="recording-guard-text">Screen recording detected</view>
          <view class="recording-guard-sub">This material is watermarked. Please stop recording.</view>
        </view>
      </view>

      <view wx:if="{{previewMode === 'image'}}" class="paper" hover-class="paper-active" bindtap="openSecurePreview">
        <view wx:if="{{pagesLoading || !previewImagePath}}" class="preview-loading">Loading preview…</view>
        <image wx:else class="preview-cover" src="{{previewImagePath}}" mode="widthFix" show-menu-by-longpress="{{false}}"></image>
        <view wx:if="{{previewImagePath}}" class="paper-foot">{{pageCount}} pages · Tap to open</view>
      </view>

      <view wx:elif="{{previewMode === 'pdf'}}" class="paper paper-fallback" hover-class="paper-active" bindtap="openSecurePreview">
        <view class="preview-file-icon">📄</view>
        <view class="preview-fallback-title">{{displayTitle}}</view>
        <view class="preview-fallback-message">{{previewMessage}}</view>
      </view>

      <view wx:elif="{{previewMode === 'unknown' || previewMode === 'processing'}}" class="paper paper-status">
        <view class="preview-unavailable-icon">⏳</view>
        <view class="preview-unavailable-title">{{previewMode === 'processing' ? 'Generating preview' : 'Loading preview'}}</view>
        <view wx:if="{{previewMessage}}" class="preview-unavailable-message">{{previewMessage}}</view>
      </view>

      <view wx:elif="{{previewMode === 'cover-error'}}" class="paper paper-status">
        <view class="preview-unavailable-icon">🖼️</view>
        <view class="preview-unavailable-title">Thumbnail failed to load</view>
        <view class="preview-unavailable-message">{{previewMessage}}</view>
        <button class="button light preview-retry" bindtap="retryPreview">Reload</button>
      </view>

      <view wx:elif="{{previewMode === 'unavailable'}}" class="paper paper-status">
        <view class="preview-unavailable-icon">📄</view>
        <view class="preview-unavailable-title">Unable to open</view>
        <view class="preview-unavailable-message">{{previewMessage}}</view>
        <button class="button light preview-retry" bindtap="retryPreview">Check again</button>
      </view>

      <view class="preview-actions">
        <button wx:if="{{showNextButton}}" class="button challenge-button" bindtap="goAnswer">Next</button>
        <view class="button-row">
          <button class="button light" bindtap="toggleFavorite">{{favorited ? 'Favorited ✓' : 'Favorite ♡'}}</button>
          <view class="download-print-wrap">
            <button class="button light download-print" disabled="{{!material.downloadUrl || downloading}}" loading="{{downloading}}" bindtap="printMaterial">Print</button>
            <view wx:if="{{!material.downloadUrl}}" class="download-permission-hint">Print is not enabled</view>
          </view>
        </view>
      </view>
    </block>

    <view wx:elif="{{contentMode === 'homework'}}" class="homework-card">
      <view class="homework-kicker">{{contentTagLabel || activeTagLabel}}</view>
      <view class="homework-title">{{activeHomework.title}}</view>
      <view class="homework-desc">{{homeworkDesc}}</view>
      <button class="button challenge-button" bindtap="goAnswer">Next</button>
    </view>

    <view wx:elif="{{contentMode === 'list'}}" class="tag-content-list">
      <view class="tag-content-list-title">{{activeTagLabel}} · {{tagItemCountText}}</view>
      <view wx:for="{{tagItems}}" wx:key="id" class="tag-content-list-item" data-id="{{item.id}}" bindtap="selectTagItem">
        <view class="tag-content-list-icon">{{item.contentType === 'homework' ? '✍️' : '📄'}}</view>
        <view class="tag-content-list-main">
          <view class="tag-content-list-name">{{item.displayName || item.title}}</view>
          <view class="tag-content-list-desc">{{item.listDesc}}</view>
        </view>
        <view wx:if="{{item.tagCode}}" class="tag-content-list-tag">{{item.tagCode}}</view>
        <view class="tag-content-list-arrow">›</view>
      </view>
    </view>

    <view wx:else class="empty-card">
      <view class="title">{{activeTagLabel}} has no content yet</view>
      <view class="sub">It will appear here after the teacher publishes it</view>
    </view>
  </view>
</view>
