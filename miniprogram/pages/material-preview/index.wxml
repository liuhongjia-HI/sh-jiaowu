<view class="hero">
  <view class="eyebrow">资料预览</view>
  <view class="hero-title">{{pageTitle}}</view>
  <view class="badge">{{material.downloadUrl ? '支持下载' : '仅支持在线查看'}}</view>
</view>
<view class="section">
  <view class="card">
    <view class="bubble">学习提示：先看例子，再做练习。</view>
    <view class="row preview-meta">
      <view class="sub">学习进度已自动保存</view>
      <view class="sub">已添加专属水印</view>
    </view>
    <view class="security-notice">{{securityNotice}}</view>

    <view wx:if="{{recordingWarning}}" class="recording-warning">
      <view class="recording-guard-icon">⚠️</view>
      <view>
        <view class="recording-guard-text">检测到系统录屏</view>
        <view class="recording-guard-sub">资料已添加专属水印，请停止录屏。</view>
      </view>
    </view>

    <view wx:if="{{previewMode === 'image'}}" class="material-preview-card" hover-class="material-preview-card-active" bindtap="openSecurePreview">
      <view wx:if="{{pagesLoading || !previewImagePath}}" class="preview-loading">正在加载课件预览…</view>
      <image wx:else class="preview-cover" src="{{previewImagePath}}" mode="widthFix" show-menu-by-longpress="{{false}}"></image>
      <view wx:if="{{previewImagePath}}" class="preview-page-count">共 {{pageCount}} 页</view>
    </view>

    <view wx:elif="{{previewMode === 'pdf'}}" class="material-preview-card preview-fallback" hover-class="material-preview-card-active" bindtap="openSecurePreview">
      <view class="preview-file-icon">📄</view>
      <view class="preview-fallback-title">{{paperTitle}}</view>
      <view class="preview-fallback-message">{{previewMessage}}</view>
    </view>

    <view wx:elif="{{previewMode === 'unknown' || previewMode === 'processing'}}" class="preview-unavailable preview-processing">
      <view class="preview-unavailable-icon">⏳</view>
        <view class="preview-unavailable-title">{{previewMode === 'processing' ? '预览生成中' : '加载预览中'}}</view>
      <view wx:if="{{previewMessage}}" class="preview-unavailable-message">{{previewMessage}}</view>
    </view>

    <view wx:elif="{{previewMode === 'cover-error'}}" class="preview-unavailable">
      <view class="preview-unavailable-icon">🖼️</view>
      <view class="preview-unavailable-title">缩略图加载失败</view>
      <view class="preview-unavailable-message">{{previewMessage}}</view>
      <button class="button light preview-retry" bindtap="retryPreview">重新加载</button>
    </view>

    <view wx:elif="{{previewMode === 'unavailable'}}" class="preview-unavailable">
      <view class="preview-unavailable-icon">📄</view>
      <view class="preview-unavailable-title">课件暂时无法打开</view>
      <view class="preview-unavailable-message">{{previewMessage}}</view>
      <button class="button light preview-retry" bindtap="retryPreview">重新检查</button>
    </view>

    <view class="badges">
      <view class="badge">{{readText}}</view>
      <view class="badge">距离小徽章还差一步</view>
    </view>
    <view class="button-row">
      <button class="button light {{material.downloadUrl ? '' : 'solo-secondary'}}" bindtap="toggleFavorite">{{favorited ? '已收藏 ✓' : '收藏讲义 ♡'}}</button>
      <button wx:if="{{material.downloadUrl}}" class="button light" bindtap="downloadMaterial">下载课件</button>
      <button class="button challenge-button" bindtap="goAnswer">开始练习</button>
    </view>
  </view>
</view>
