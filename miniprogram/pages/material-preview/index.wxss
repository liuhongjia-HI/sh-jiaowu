.preview-meta {
  margin: 22rpx 0 0;
}

.paper {
  position: relative;
  min-height: 520rpx;
  margin-top: 24rpx;
  border-radius: 28rpx;
  background: #fffaf6;
  border: 1rpx solid #f1dfd4;
  padding: 34rpx;
  overflow: hidden;
}

.security-notice {
  margin-top: 18rpx;
  padding: 18rpx 22rpx;
  border-radius: 22rpx;
  background: #fff2ea;
  color: #9a5b3d;
  font-size: 24rpx;
  line-height: 1.5;
}

.watermark-layer {
  position: absolute;
  inset: 0;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 44rpx 18rpx;
  padding: 54rpx 0;
  pointer-events: none;
  z-index: 1;
}

.watermark {
  transform: rotate(-24deg);
  opacity: .11;
  font-size: 24rpx;
  font-weight: 800;
  color: #5d4d45;
  white-space: nowrap;
  text-align: center;
}

.paper-title {
  position: relative;
  z-index: 2;
  font-size: 34rpx;
  font-weight: 850;
  margin-bottom: 30rpx;
}

.paper-line {
  position: relative;
  z-index: 2;
  height: 20rpx;
  background: #eee3dc;
  border-radius: 999rpx;
  margin-bottom: 22rpx;
}

.paper-line.short {
  width: 70%;
}

.paper-line.tiny {
  width: 52%;
}

.paper-block {
  position: relative;
  z-index: 2;
  height: 180rpx;
  border-radius: 24rpx;
  background: #fff2ea;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  margin: 36rpx 0;
}
