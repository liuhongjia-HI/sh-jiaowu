.preview-meta {
  margin: 22rpx 0 0;
}

.paper {
  position: relative;
  min-height: 520rpx;
  margin-top: 24rpx;
  border-radius: 28rpx;
  background: #fffaf6;
  border: 1rpx solid #f1dfd4;
  padding: 34rpx;
  overflow: hidden;
}

.security-notice {
  margin-top: 18rpx;
  padding: 18rpx 22rpx;
  border-radius: 22rpx;
  background: #fff2ea;
  color: #9a5b3d;
  font-size: 24rpx;
  line-height: 1.5;
}

.watermark-layer {
  position: absolute;
  inset: 0;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 44rpx 18rpx;
  padding: 54rpx 0;
  pointer-events: none;
  z-index: 1;
}

.watermark {
  transform: rotate(-24deg);
  opacity: .11;
  font-size: 24rpx;
  font-weight: 800;
  color: #5d4d45;
  white-space: nowrap;
  text-align: center;
}

.paper-title {
  position: relative;
  z-index: 2;
  font-size: 34rpx;
  font-weight: 850;
  margin-bottom: 30rpx;
}

.paper-line {
  position: relative;
  z-index: 2;
  height: 20rpx;
  background: #eee3dc;
  border-radius: 999rpx;
  margin-bottom: 22rpx;
}

.paper-line.short {
  width: 70%;
}

.paper-line.tiny {
  width: 52%;
}

.paper-block {
  position: relative;
  z-index: 2;
  height: 180rpx;
  border-radius: 24rpx;
  background: #fff2ea;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  margin: 36rpx 0;
}

.recording-guard,
.recording-warning {
  margin-top: 24rpx;
  min-height: 400rpx;
  border-radius: 28rpx;
  background: #2a2320;
  color: #fff2ea;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.recording-warning {
  min-height: 0;
  flex-direction: row;
  justify-content: flex-start;
  gap: 20rpx;
  background: #fff2ea;
  color: #8a4b32;
  padding: 24rpx;
}

.recording-guard-icon {
  font-size: 56rpx;
  margin-bottom: 16rpx;
}

.recording-guard-text {
  font-size: 30rpx;
  font-weight: 700;
}

.recording-guard-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  opacity: .7;
}

.paged-preview {
  margin-top: 24rpx;
}

.page-wrap {
  position: relative;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  border: 1rpx solid #f1dfd4;
  background: #fffaf6;
}

.preview-unavailable {
  margin-top: 24rpx;
  padding: 46rpx 30rpx;
  border-radius: 24rpx;
  background: #fff8f3;
  border: 1rpx solid #f1d8ca;
  text-align: center;
}

.preview-unavailable-icon { font-size: 58rpx; }
.preview-unavailable-title { margin-top: 18rpx; font-size: 30rpx; font-weight: 800; color: #46352d; }
.preview-unavailable-message { margin-top: 12rpx; color: #8a6554; font-size: 24rpx; line-height: 1.6; }
.preview-retry { margin-top: 24rpx; }

.page-image {
  width: 100%;
  display: block;
}

.page-placeholder,
.page-error {
  min-height: 360rpx;
  padding: 40rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #9a5b3d;
  text-align: center;
}

.page-error-message {
  margin-top: 12rpx;
  color: #8c7b72;
  font-size: 22rpx;
  word-break: break-all;
}

.page-retry {
  margin-top: 22rpx;
  min-width: 220rpx;
}

.page-index {
  position: relative;
  z-index: 2;
  text-align: center;
  padding: 12rpx 0;
  font-size: 22rpx;
  color: #9a5b3d;
  background: #fff2ea;
}

.page-loading {
  text-align: center;
  padding: 24rpx 0;
  font-size: 24rpx;
  color: #9a5b3d;
}
