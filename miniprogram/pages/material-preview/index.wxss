.material-preview-page {
  min-height: 100vh;
  background: #f7f7f8;
}

.preview-header,
.lesson-tag-filter,
.preview-actions {
  position: relative;
  z-index: 7;
  background: #fff;
}

.preview-header {
  padding: 28rpx 32rpx 18rpx;
}

.preview-title {
  color: #17181b;
  font-size: 40rpx;
  font-weight: 850;
  line-height: 1.28;
  word-break: break-word;
}

.preview-meta-line {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx 14rpx;
  margin-top: 12rpx;
}

.preview-kicker,
.preview-code {
  display: inline-flex;
  align-items: center;
  min-height: 40rpx;
  padding: 0 12rpx;
  border-radius: 10rpx;
  font-size: 20rpx;
  font-weight: 700;
}

.preview-kicker {
  background: #fff4ef;
  color: #ff5a1f;
}

.preview-code {
  background: #f3f4f6;
  color: #6b7280;
}

.lesson-tag-filter {
  padding: 8rpx 0 18rpx;
  white-space: nowrap;
  border-bottom: 1rpx solid #ededf0;
}

.lesson-tag-filter-inner {
  display: inline-flex;
  gap: 12rpx;
  padding: 0 32rpx;
}

.lesson-tag {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  min-height: 64rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #f3f4f6;
  color: #5f636c;
  font-size: 26rpx;
  font-weight: 750;
}

.lesson-tag.is-active {
  background: #ff5a1f;
  color: #fff;
  box-shadow: 0 8rpx 18rpx rgba(255, 90, 31, .18);
}

.lesson-tag.is-empty {
  opacity: .55;
}

.lesson-tag.is-active.is-empty {
  opacity: 1;
}

.lesson-tag-count {
  min-width: 28rpx;
  color: inherit;
  font-size: 22rpx;
  font-weight: 800;
  opacity: .86;
}

.section {
  padding: 24rpx 32rpx 48rpx;
}

.paper {
  position: relative;
  overflow: hidden;
  min-height: 520rpx;
  border: 1rpx solid #ece4de;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 16rpx 40rpx rgba(55, 40, 32, .08);
}

.paper-active {
  opacity: .92;
}

.preview-cover {
  width: 100%;
  display: block;
}

.preview-loading,
.paper-fallback,
.paper-status {
  min-height: 420rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx 32rpx;
  box-sizing: border-box;
  text-align: center;
}

.preview-loading {
  color: #9a5b3d;
  font-size: 26rpx;
}

.paper-foot {
  position: absolute;
  right: 18rpx;
  bottom: 18rpx;
  z-index: 3;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(23, 24, 27, .78);
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
}

.preview-file-icon,
.preview-unavailable-icon {
  font-size: 64rpx;
}

.preview-fallback-title,
.preview-unavailable-title {
  margin-top: 18rpx;
  color: #2b2522;
  font-size: 30rpx;
  font-weight: 800;
}

.preview-fallback-message,
.preview-unavailable-message {
  margin-top: 12rpx;
  color: #8a6554;
  font-size: 24rpx;
  line-height: 1.55;
}

.preview-retry {
  width: 280rpx;
  margin-top: 24rpx;
}

.preview-actions {
  margin-top: 16rpx;
  padding: 8rpx 0 12rpx;
  background: #f7f7f8;
}

.preview-actions .challenge-button {
  margin-top: 12rpx;
}

.preview-actions .button-row {
  margin-top: 4rpx;
}

.homework-card,
.tag-content-list,
.empty-card {
  padding: 36rpx 28rpx;
  border-radius: 24rpx;
  background: #fff;
}

.homework-kicker {
  color: #ff5a1f;
  font-size: 22rpx;
  font-weight: 800;
}

.homework-title,
.tag-content-list-title {
  margin-top: 10rpx;
  color: #17181b;
  font-size: 32rpx;
  font-weight: 850;
}

.homework-desc {
  margin: 12rpx 0 28rpx;
  color: #8b8e98;
  font-size: 24rpx;
}

.tag-content-list-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f0f1f4;
}

.tag-content-list-item:last-child {
  border-bottom: 0;
  padding-bottom: 0;
}

.tag-content-list-icon {
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  background: #fff0e9;
  color: #ff5a1f;
  text-align: center;
  line-height: 58rpx;
}

.tag-content-list-main {
  flex: 1;
  min-width: 0;
}

.tag-content-list-name {
  overflow: hidden;
  color: #292b34;
  font-size: 26rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tag-content-list-desc {
  margin-top: 6rpx;
  color: #9a9da8;
  font-size: 22rpx;
}

.tag-content-list-tag {
  flex-shrink: 0;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #fff4ef;
  color: #ff5a1f;
  font-size: 20rpx;
  font-weight: 800;
}

.tag-content-list-arrow {
  color: #a2a5af;
  font-size: 40rpx;
}

.back-to-list {
  display: inline-flex;
  align-items: center;
  margin-bottom: 16rpx;
  color: #6b6f78;
  font-size: 24rpx;
  font-weight: 700;
}

.global-watermark-layer {
  position: fixed;
  inset: 0;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  grid-auto-rows: minmax(180rpx, 1fr);
  gap: 80rpx 16rpx;
  padding: 120rpx 0 40rpx;
  box-sizing: border-box;
  pointer-events: none;
  z-index: 6;
}

.global-watermark {
  transform: rotate(-24deg);
  opacity: .05;
  color: #5d4d45;
  font-size: 22rpx;
  font-weight: 800;
  text-align: center;
  white-space: nowrap;
}

.recording-warning {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 18rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: #fff2ea;
  color: #8a4b32;
}

.recording-guard-icon {
  font-size: 36rpx;
}

.recording-guard-text {
  font-size: 26rpx;
  font-weight: 700;
}

.recording-guard-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  opacity: .75;
}

.download-print[disabled] {
  color: #a5a5a5;
  background: #f3f3f3;
  border-color: #e4e4e4;
}

.download-permission-hint {
  display: none;
}
