.preview-meta {
  margin: 22rpx 0 0;
}

.global-watermark-layer {
  position: fixed;
  inset: 0;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  grid-auto-rows: minmax(150rpx, 1fr);
  gap: 70rpx 16rpx;
  padding: 80rpx 0;
  box-sizing: border-box;
  pointer-events: none;
  z-index: 20;
}

.global-watermark {
  transform: rotate(-24deg);
  opacity: .09;
  color: #5d4d45;
  font-size: 24rpx;
  font-weight: 800;
  text-align: center;
  white-space: nowrap;
}

.material-preview-card {
  position: relative;
  min-height: 520rpx;
  margin-top: 24rpx;
  border-radius: 28rpx;
  background: #fffaf6;
  border: 1rpx solid #f1dfd4;
  padding: 34rpx;
  overflow: hidden;
}

.preview-cover {
  position: relative;
  z-index: 0;
  width: 100%;
  display: block;
}

.preview-loading {
  min-height: 520rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9a5b3d;
  font-size: 26rpx;
}

.preview-page-count {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  z-index: 3;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(42, 35, 32, .82);
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
}

.material-preview-card-active {
  opacity: .9;
}

.preview-fallback {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-bottom: 34rpx;
}

.preview-file-icon { position: relative; z-index: 2; font-size: 76rpx; }
.preview-fallback-title { position: relative; z-index: 2; margin-top: 24rpx; font-size: 32rpx; font-weight: 800; }
.preview-fallback-message { position: relative; z-index: 2; margin-top: 14rpx; color: #8a6554; font-size: 24rpx; text-align: center; }
.preview-processing { border-style: dashed; }

.challenge-button,
.solo-secondary {
  grid-column: 1 / -1;
}

.security-notice {
  margin-top: 18rpx;
  padding: 18rpx 22rpx;
  border-radius: 22rpx;
  background: #fff2ea;
  color: #9a5b3d;
  font-size: 24rpx;
  line-height: 1.5;
}

.recording-guard,
.recording-warning {
  margin-top: 24rpx;
  min-height: 400rpx;
  border-radius: 28rpx;
  background: #2a2320;
  color: #fff2ea;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.recording-warning {
  min-height: 0;
  flex-direction: row;
  justify-content: flex-start;
  gap: 20rpx;
  background: #fff2ea;
  color: #8a4b32;
  padding: 24rpx;
}

.recording-guard-icon {
  font-size: 56rpx;
  margin-bottom: 16rpx;
}

.recording-guard-text {
  font-size: 30rpx;
  font-weight: 700;
}

.recording-guard-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  opacity: .7;
}

.preview-unavailable {
  margin-top: 24rpx;
  padding: 46rpx 30rpx;
  border-radius: 24rpx;
  background: #fff8f3;
  border: 1rpx solid #f1d8ca;
  text-align: center;
}

.preview-unavailable-icon { font-size: 58rpx; }
.preview-unavailable-title { margin-top: 18rpx; font-size: 30rpx; font-weight: 800; color: #46352d; }
.preview-unavailable-message { margin-top: 12rpx; color: #8a6554; font-size: 24rpx; line-height: 1.6; }
.preview-retry { margin-top: 24rpx; }
