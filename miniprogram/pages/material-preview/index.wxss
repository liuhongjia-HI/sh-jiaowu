.preview-meta {
  margin: 22rpx 0 0;
}

/* 资料预览页的内容层级：白色信息头部 + 浅灰阅读区。 */
.material-preview-page {
  min-height: 100vh;
  background: #f7f7f8;
}

.material-preview-page .hero {
  padding: 56rpx 64rpx 42rpx;
  background: #fff;
  border-bottom: 1rpx solid #ededf0;
}

.material-preview-page .hero::after {
  right: -56rpx;
  top: -52rpx;
  width: 210rpx;
  height: 210rpx;
  background: #fff1eb;
}

.material-preview-page .eyebrow {
  color: #8b8e98;
  font-size: 24rpx;
}

.material-preview-page .hero-title {
  max-width: 900rpx;
  margin-top: 14rpx;
  color: #17181b;
  font-size: 56rpx;
  font-weight: 900;
  letter-spacing: -1rpx;
  line-height: 1.16;
}

.material-preview-page .section {
  padding: 34rpx 64rpx 48rpx;
}

.lesson-tag-filter { padding: 22rpx 0 8rpx; background: #fff; white-space: nowrap; }
.lesson-tag-filter-inner { display: inline-flex; gap: 14rpx; padding: 0 32rpx; }
.lesson-tag { min-width: 116rpx; padding: 14rpx 18rpx; border-radius: 18rpx; background: #f0f1f4; color: #696d77; text-align: center; }
.lesson-tag.is-active { background: #ff5a1f; color: #fff; box-shadow: 0 8rpx 18rpx rgba(255, 90, 31, .2); }
.lesson-tag-code { font-size: 24rpx; font-weight: 850; }
.lesson-tag-name { margin-top: 3rpx; font-size: 18rpx; }
.tag-item-filter { padding: 12rpx 0; background: #fff; white-space: nowrap; }
.tag-item-filter-inner { display: inline-flex; gap: 12rpx; padding: 0 32rpx; }
.tag-item { max-width: 360rpx; overflow: hidden; padding: 10rpx 16rpx; border: 1rpx solid #e4e5e9; border-radius: 999rpx; color: #777a83; font-size: 20rpx; text-overflow: ellipsis; white-space: nowrap; }
.tag-item.is-active { border-color: #ffb69b; background: #fff4ef; color: #ff5a1f; }
.tag-content-list { padding: 28rpx; background: #fff; }
.tag-content-list-title { margin-bottom: 18rpx; color: #262832; font-size: 30rpx; font-weight: 800; }
.tag-content-list-item { display: flex; align-items: center; gap: 18rpx; padding: 22rpx 0; border-bottom: 1rpx solid #eceef2; }
.tag-content-list-icon { width: 58rpx; height: 58rpx; border-radius: 50%; background: #fff0e9; color: #ff5a1f; text-align: center; line-height: 58rpx; }
.tag-content-list-main { flex: 1; min-width: 0; }
.tag-content-list-name { overflow: hidden; color: #292b34; font-size: 26rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.tag-content-list-desc { margin-top: 6rpx; color: #9a9da8; font-size: 22rpx; }
.tag-content-list-arrow { color: #a2a5af; font-size: 40rpx; }

.lesson-content-state { padding: 78rpx 28rpx 34rpx; text-align: center; }
.lesson-content-icon { font-size: 72rpx; }
.lesson-content-title { margin-top: 24rpx; color: #35363b; font-size: 30rpx; font-weight: 800; }
.lesson-content-desc { margin: 14rpx 0 34rpx; color: #92959e; font-size: 23rpx; }

.material-preview-page .card {
  padding: 34rpx;
  border-radius: 28rpx;
  background: #fff;
}

.global-watermark-layer {
  position: fixed;
  inset: 0;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  grid-auto-rows: minmax(150rpx, 1fr);
  gap: 70rpx 16rpx;
  padding: 80rpx 0;
  box-sizing: border-box;
  pointer-events: none;
  z-index: 20;
}

.global-watermark {
  transform: rotate(-24deg);
  opacity: .09;
  color: #5d4d45;
  font-size: 24rpx;
  font-weight: 800;
  text-align: center;
  white-space: nowrap;
}

.material-preview-card {
  position: relative;
  min-height: 520rpx;
  margin-top: 24rpx;
  border-radius: 28rpx;
  background: #fffaf6;
  border: 1rpx solid #f1dfd4;
  padding: 34rpx;
  overflow: hidden;
}

.preview-cover {
  position: relative;
  z-index: 0;
  width: 100%;
  display: block;
}

.preview-loading {
  min-height: 520rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9a5b3d;
  font-size: 26rpx;
}

.preview-page-count {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  z-index: 3;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(42, 35, 32, .82);
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
}

.material-preview-card-active {
  opacity: .9;
}

.preview-fallback {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-bottom: 34rpx;
}

.preview-file-icon { position: relative; z-index: 2; font-size: 76rpx; }
.preview-fallback-title { position: relative; z-index: 2; margin-top: 24rpx; font-size: 32rpx; font-weight: 800; }
.preview-fallback-message { position: relative; z-index: 2; margin-top: 14rpx; color: #8a6554; font-size: 24rpx; text-align: center; }
.preview-processing { border-style: dashed; }

.challenge-button,
.download-print-wrap {
  grid-column: 1 / -1;
}

.recording-guard,
.recording-warning {
  margin-top: 24rpx;
  min-height: 400rpx;
  border-radius: 28rpx;
  background: #2a2320;
  color: #fff2ea;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.recording-warning {
  min-height: 0;
  flex-direction: row;
  justify-content: flex-start;
  gap: 20rpx;
  background: #fff2ea;
  color: #8a4b32;
  padding: 24rpx;
}

.recording-guard-icon {
  font-size: 56rpx;
  margin-bottom: 16rpx;
}

.recording-guard-text {
  font-size: 30rpx;
  font-weight: 700;
}

.recording-guard-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  opacity: .7;
}

.preview-unavailable {
  margin-top: 24rpx;
  padding: 46rpx 30rpx;
  border-radius: 24rpx;
  background: #fff8f3;
  border: 1rpx solid #f1d8ca;
  text-align: center;
}

.preview-unavailable-icon { font-size: 58rpx; }
.preview-unavailable-title { margin-top: 18rpx; font-size: 30rpx; font-weight: 800; color: #46352d; }
.preview-unavailable-message { margin-top: 12rpx; color: #8a6554; font-size: 24rpx; line-height: 1.6; }
.preview-retry { margin-top: 24rpx; }

.download-print[disabled] {
  color: #a5a5a5;
  background: #f3f3f3;
  border-color: #e4e4e4;
}

.download-permission-hint {
	display: none;
  color: #8b8e98;
  font-size: 24rpx;
  text-align: center;
}

.download-print-wrap:hover .download-permission-hint {
  display: block;
}
