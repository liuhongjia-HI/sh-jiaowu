}

.recent-cover-art {
  right: 10rpx;
  bottom: 10rpx;
  width: 60rpx;
  height: 60rpx;
  font-size: 32rpx;
}

.recent-title {
  font-size: 28rpx;
  font-weight: 800;
}

.recent-date {
  margin-top: 6rpx;
