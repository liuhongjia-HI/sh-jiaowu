.me-page {
  min-height: 100vh;
  background: #f8f5f1;
  color: #2b2522;
}

.learning-shell {
  padding: 24rpx 28rpx 150rpx;
}

.page-state,
.login-state {
  padding: 96rpx 40rpx;
  text-align: center;
}

.page-state {
  color: #89776e;
  font-size: 26rpx;
}

.login-state {
  margin: 32rpx 28rpx;
  border: 1rpx solid #eadbd2;
  border-radius: 24rpx;
  background: #fff;
}

.login-title {
  color: #2b2522;
  font-size: 34rpx;
  font-weight: 850;
}

.login-desc {
  margin-top: 12rpx;
  color: #89776e;
  font-size: 25rpx;
  line-height: 1.6;
}

.learning-header {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 26rpx;
  border: 1rpx solid #eadbd2;
  border-radius: 24rpx;
  background: #fff;
}

.avatar-control {
  flex: none;
  width: 104rpx;
  height: 104rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 30rpx;
  background: #f0e7df;
  overflow: hidden;
}

.avatar-control::after,
.primary-button::after,
.secondary-button::after,
.profile-save::after {
  border: 0;
}

.avatar-image,
.avatar-text {
  width: 104rpx;
  height: 104rpx;
  border-radius: 30rpx;
}

.avatar-text {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f3e4d8;
  color: #9d5f43;
  font-size: 38rpx;
  font-weight: 850;
}

.student-copy {
  flex: 1;
  min-width: 0;
}

.student-name {
  overflow: hidden;
  color: #2b2522;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.student-meta,
.student-status {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.student-meta {
  margin-top: 6rpx;
  color: #7d6d65;
  font-size: 24rpx;
  line-height: 1.4;
}

.student-status {
  margin-top: 8rpx;
  color: #ad6a46;
  font-size: 22rpx;
  line-height: 1.4;
}

.profile-sync {
  flex: none;
  max-width: 136rpx;
  padding: 8rpx 12rpx;
  border-radius: 999rpx;
  background: #fff2ea;
  color: #c46a45;
  font-size: 20rpx;
  font-weight: 750;
  line-height: 1.25;
  text-align: center;
}

.primary-panel {
  margin-top: 18rpx;
  padding: 30rpx;
  border-radius: 26rpx;
  background: #fff;
  box-shadow: 0 14rpx 34rpx rgba(91, 67, 52, .08);
}

.primary-panel.urgent {
  background: linear-gradient(135deg, #fff1e8 0%, #ffffff 72%);
  border: 1rpx solid #ffd7c5;
}

.primary-panel.active {
  background: linear-gradient(135deg, #eef7f3 0%, #ffffff 72%);
  border: 1rpx solid #d7ebe2;
}

.primary-panel.review {
  background: linear-gradient(135deg, #f3f1ff 0%, #ffffff 72%);
  border: 1rpx solid #e2dcff;
}

.primary-panel.quiet {
  border: 1rpx solid #eadbd2;
  box-shadow: none;
}

.task-label {
  display: inline-flex;
  align-items: center;
  min-height: 42rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 159, 127, .14);
  color: #c05f3a;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 42rpx;
}

.task-title {
  margin-top: 18rpx;
  color: #2b2522;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.3;
}

.task-desc {
  margin-top: 10rpx;
  color: #74645d;
  font-size: 25rpx;
  line-height: 1.55;
}

.primary-button {
  box-sizing: border-box;
  width: 100%;
  height: 82rpx;
  margin: 0;
  border: 0;
  border-radius: 20rpx;
  background: #f27f5c;
  color: #fff;
  font-size: 27rpx;
  font-weight: 850;
  line-height: 82rpx;
}

.task-button {
  margin-top: 26rpx;
}

.metric-strip {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  margin-top: 18rpx;
  padding: 20rpx 12rpx;
  border: 1rpx solid #eadbd2;
  border-radius: 22rpx;
  background: #fff;
}

.metric-item {
  min-width: 0;
  padding: 0 12rpx;
  border-right: 1rpx solid #efe3dc;
}

.metric-item:last-child {
  border-right: 0;
}

.metric-value {
  overflow: hidden;
  color: #2b2522;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.metric-label {
  margin-top: 6rpx;
  color: #776861;
  font-size: 22rpx;
  font-weight: 780;
  line-height: 1.35;
}

.metric-hint {
  margin-top: 4rpx;
  overflow: hidden;
  color: #aa9a92;
  font-size: 19rpx;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.content-section {
  margin-top: 28rpx;
}

.section-title {
  margin-bottom: 14rpx;
  color: #2b2522;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.35;
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}

.quick-action {
  position: relative;
  min-height: 142rpx;
  padding: 18rpx 14rpx;
  border: 1rpx solid #eadbd2;
  border-radius: 20rpx;
  background: #fff;
}

.quick-symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border-radius: 16rpx;
  background: #f3e9e0;
  color: #a76445;
  font-size: 23rpx;
  font-weight: 900;
}

.quick-copy {
  min-width: 0;
  margin-top: 14rpx;
}

.quick-title,
.quick-desc {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.quick-title {
  color: #2b2522;
  font-size: 24rpx;
  font-weight: 850;
  line-height: 1.35;
}

.quick-desc {
  margin-top: 4rpx;
  color: #8a7a72;
  font-size: 20rpx;
  line-height: 1.35;
}

.quick-badge {
  position: absolute;
  right: 10rpx;
  top: 10rpx;
  max-width: 92rpx;
  padding: 4rpx 8rpx;
  border-radius: 999rpx;
  background: #fff0e8;
  color: #c05f3a;
  font-size: 18rpx;
  font-weight: 800;
  line-height: 1.2;
}

.support-card,
.notice-line {
  margin-top: 18rpx;
  border: 1rpx solid #eadbd2;
  border-radius: 22rpx;
  background: #fff;
}

.support-card {
  padding: 24rpx;
}

.support-main {
  min-width: 0;
}

.support-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.support-title {
  color: #2b2522;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.35;
}

.support-status {
  flex: none;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1.25;
}

.support-status.complete {
  background: #eef7f3;
  color: #3d856c;
}

.support-status.pending {
  background: #fff0e8;
  color: #c05f3a;
}

.support-desc,
.support-note {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.support-desc {
  margin-top: 10rpx;
  color: #5d504a;
  font-size: 24rpx;
  font-weight: 750;
  line-height: 1.45;
}

.support-note {
  margin-top: 4rpx;
  color: #95867e;
  font-size: 21rpx;
  line-height: 1.45;
}

.secondary-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 116rpx;
  height: 56rpx;
  margin: 18rpx 0 0;
  padding: 0 22rpx;
  border: 0;
  border-radius: 999rpx;
  background: #f6ede7;
  color: #b5603f;
  font-size: 23rpx;
  font-weight: 850;
  line-height: 56rpx;
}

.profile-form {
  display: grid;
  gap: 14rpx;
  margin-top: 20rpx;
}

.form-input {
  box-sizing: border-box;
  width: 100%;
  height: 76rpx;
  padding: 0 22rpx;
  border: 1rpx solid #eadbd2;
  border-radius: 18rpx;
  background: #fffaf7;
  color: #2b2522;
  font-size: 24rpx;
}

.profile-save {
  box-sizing: border-box;
  width: 100%;
  height: 76rpx;
  margin: 0;
  border: 0;
  border-radius: 18rpx;
  background: #f27f5c;
  color: #fff;
  font-size: 25rpx;
  font-weight: 850;
  line-height: 76rpx;
}

.notice-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 22rpx 24rpx;
}

.notice-title {
  color: #2b2522;
  font-size: 26rpx;
  font-weight: 850;
  line-height: 1.35;
}

.notice-desc {
  margin-top: 4rpx;
  color: #897970;
  font-size: 22rpx;
  line-height: 1.4;
}

.notice-action {
  flex: none;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #f6ede7;
  color: #b5603f;
  font-size: 21rpx;
  font-weight: 850;
  line-height: 1.25;
}
