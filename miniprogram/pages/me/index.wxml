<view class="me-page" style="padding-top: {{statusBarHeight}}px;">
  <view wx:if="{{loading}}" class="page-state">正在同步学习状态...</view>

  <view wx:elif="{{!me}}" class="login-state">
    <view class="login-title">还没有登录</view>
    <view class="login-desc">{{emptyMessage}}</view>
    <button class="primary-button" bindtap="goLogin">去登录绑定</button>
  </view>

  <view wx:else class="me-shell">
    <view class="me-toolbar">
      <view class="me-toolbar-icon settings-icon" bindtap="toggleProfileEdit" aria-label="账号设置">⚙</view>
    </view>

    <view class="profile-card">
      <button class="profile-avatar" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" disabled="{{savingProfile}}" aria-label="选择微信头像">
        <image wx:if="{{studentProfile.avatarUrl}}" class="profile-avatar-image" src="{{studentProfile.avatarUrl}}" mode="aspectFill"></image>
        <view wx:else class="profile-avatar-fallback" aria-hidden="true">
          <view class="avatar-illustration-body"></view>
          <view class="avatar-illustration-hair"></view>
          <view class="avatar-illustration-face"></view>
          <view class="avatar-illustration-eye avatar-eye-left"></view>
          <view class="avatar-illustration-eye avatar-eye-right"></view>
        </view>
      </button>
      <view class="profile-copy">
        <view class="profile-greeting">下午好，</view>
        <input class="profile-nickname" type="nickname" value="{{profileForm.nickname}}" placeholder="微信用户" bindinput="onNicknameInput" bindblur="commitNickname" confirm-type="done" aria-label="微信昵称" />
        <button class="profile-phone-action {{studentProfile.phoneAuthorized ? 'authorized' : 'pending'}}" open-type="getPhoneNumber" bindgetphonenumber="authorizePhone" loading="{{savingProfile}}" disabled="{{savingProfile}}" aria-label="授权手机号">
          <text>{{studentProfile.phoneHint}}</text>
        </button>
      </view>
      <view class="profile-arrow" bindtap="toggleProfileEdit">›</view>
    </view>

    <view wx:if="{{studentAccounts.length}}" class="student-switcher">
      <view class="student-switcher-label">当前学生</view>
      <view class="student-switcher-list">
        <button wx:for="{{studentAccounts}}" wx:key="studentId" class="student-switch-button {{item.active ? 'active' : ''}} {{!item.canSwitch && !item.active ? 'pending' : ''}}" data-student-id="{{item.studentId}}" bindtap="switchStudent" loading="{{switchingStudentId === item.studentId}}" disabled="{{!item.canSwitch && !item.active || switchingStudentId}}">
          <text>{{item.name}} · {{item.grade}}</text>
          <text wx:if="{{!item.canSwitch}}" class="student-switch-status">暂不可切换</text>
        </button>
        <button class="student-add-button" bindtap="openStudentAddModal">＋ 添加学生</button>
      </view>
    </view>

    <view class="me-section recent-section">
      <view class="me-section-head">
        <view class="me-section-title">继续学习</view>
        <view class="me-section-more" bindtap="goStudy">学习中心 ›</view>
      </view>
      <view wx:if="{{recentLearning}}" class="recent-card" bindtap="goStudyDetail">
        <view class="recent-cover">
          <view class="recent-cover-circle"></view>
          <view class="recent-cover-art">{{recentLearning.coverIcon || "📖"}}</view>
        </view>
        <view class="recent-copy">
          <view class="recent-title">{{recentLearning.name}}</view>
          <view class="recent-date">最近学习：{{recentLearning.lastStudyAt || "今天"}}</view>
          <view class="recent-progress-row"><text>已学 {{recentLearning.completedLessons}}/{{recentLearning.chapterCount}} 节</text><text>{{recentLearning.progress}}%</text></view>
          <view class="recent-progress"><view class="recent-progress-bar" style="width: {{recentLearning.progress}}%;"></view></view>
          <view class="recent-cta">继续学习 <text>›</text></view>
        </view>
      </view>
          <view wx:else class="recent-empty">暂无学习记录，去学习吧。</view>
    </view>

    <view class="metric-strip">
      <view wx:for="{{overviewMetrics}}" wx:key="label" class="metric-item">
        <view class="metric-value {{item.emphasis ? 'metric-emphasis' : ''}}">{{item.value}}</view>
        <view class="metric-label">{{item.label}}</view>
      </view>
    </view>

    <view class="me-section function-section">
      <view class="me-section-title">常用功能</view>
      <view class="quick-grid">
        <block wx:for="{{quickActions}}" wx:key="action">
          <view wx:if="{{item.action === 'schedule' || item.action === 'study' || item.action === 'favorites' || item.action === 'notices'}}" class="quick-action quick-action-{{item.tone}}" data-action="{{item.action}}" bindtap="handleQuickAction">
            <view class="quick-symbol">{{item.symbol}}</view>
            <view class="quick-title">{{item.title}}</view>
          </view>
        </block>
      </view>
    </view>

    <view wx:if="{{profileEditing}}" class="profile-modal-mask" bindtap="toggleProfileEdit">
      <view class="profile-modal" catchtap="stopModalTap">
        <view class="profile-modal-head">
          <view>
            <view class="profile-modal-title">编辑我的资料</view>
            <view class="profile-modal-subtitle">完善信息，老师才能更准确地记录学习反馈</view>
          </view>
          <view class="profile-modal-close" bindtap="toggleProfileEdit">×</view>
        </view>

        <view class="profile-modal-status-row">
          <view class="profile-modal-status {{profileCompleteness.statusClass}}">{{profileCompleteness.status}}</view>
          <view class="profile-modal-status-desc">{{profileCompleteness.summary}}</view>
        </view>

        <view class="profile-form">
          <input class="form-input" value="{{profileForm.studentName}}" data-field="studentName" bindinput="onBasicInput" placeholder="学生姓名" />
          <view class="form-readonly">
            <view class="form-readonly-value">{{profileForm.grade || "年级待补全"}}</view>
            <view class="form-readonly-hint">年级按学年自动升级，如有误差请联系老师订正</view>
          </view>
          <input class="form-input" value="{{profileForm.schoolName}}" data-field="schoolName" bindinput="onBasicInput" placeholder="学校" />
          <input class="form-input" value="{{profileForm.guardianName}}" data-field="guardianName" bindinput="onBasicInput" placeholder="家长称呼（选填）" />
          <button class="profile-save" bindtap="submitBasicProfile" loading="{{savingBasicProfile}}" disabled="{{savingBasicProfile}}">保存资料</button>
        </view>
      </view>
    </view>

    <view wx:if="{{studentAddOpen}}" class="profile-modal-mask" bindtap="closeStudentAddModal">
      <view class="profile-modal" catchtap="stopModalTap">
        <view class="profile-modal-head">
          <view>
            <view class="profile-modal-title">添加学生</view>
            <view class="profile-modal-subtitle">填写孩子的基本信息，即可切换查看和开始体验。</view>
          </view>
          <view class="profile-modal-close" bindtap="closeStudentAddModal">×</view>
        </view>
        <view class="profile-form">
          <input class="form-input" value="{{studentAddForm.name}}" data-field="name" bindinput="onStudentAddInput" placeholder="学生姓名" maxlength="32" />
          <picker mode="selector" range="{{gradeOptions}}" value="{{studentAddGradeIndex}}" bindchange="onStudentAddGradeChange">
            <view class="form-input form-picker {{studentAddForm.grade ? '' : 'placeholder'}}">{{studentAddForm.grade || "请选择年级"}}</view>
          </picker>
          <input class="form-input" value="{{studentAddForm.schoolName}}" data-field="schoolName" bindinput="onStudentAddInput" placeholder="学校" maxlength="64" />
          <view class="student-add-hint">添加后立即可用；已配置体验的课程会开放第一章内容。</view>
          <button class="profile-save" bindtap="submitStudentAdd" loading="{{addingStudent}}" disabled="{{addingStudent}}">确认添加</button>
        </view>
      </view>
    </view>
  </view>
</view>
