<view class="me-page">
  <view wx:if="{{loading}}" class="page-state">正在同步学习状态...</view>

  <view wx:elif="{{!me}}" class="login-state">
    <view class="login-title">还没有登录</view>
    <view class="login-desc">{{emptyMessage}}</view>
    <button class="primary-button" bindtap="goLogin">去登录绑定</button>
  </view>

  <view wx:else class="learning-shell">
    <view class="learning-header">
      <button class="avatar-control" bindtap="authorizeProfile" disabled="{{savingProfile}}" aria-label="补充头像昵称">
        <image wx:if="{{studentProfile.avatarUrl}}" class="avatar-image" src="{{studentProfile.avatarUrl}}" mode="aspectFill"></image>
        <view wx:else class="avatar-text">{{studentProfile.avatarText}}</view>
      </button>
      <view class="student-copy">
        <view class="student-name">{{studentProfile.displayName}}</view>
        <view class="student-meta">{{studentProfile.meta}}</view>
        <view class="student-status">{{studentProfile.status}}</view>
      </view>
      <view class="profile-sync">{{studentProfile.profileHint}}</view>
    </view>

    <view class="primary-panel {{primaryTask.tone}}">
      <view class="task-label">{{primaryTask.label}}</view>
      <view class="task-title">{{primaryTask.title}}</view>
      <view class="task-desc">{{primaryTask.desc}}</view>
      <button class="primary-button task-button" bindtap="handlePrimaryAction">{{primaryTask.buttonText}}</button>
    </view>

    <view class="metric-strip">
      <view wx:for="{{overviewMetrics}}" wx:key="label" class="metric-item">
        <view class="metric-value">{{item.value}}</view>
        <view class="metric-label">{{item.label}}</view>
        <view class="metric-hint">{{item.hint}}</view>
      </view>
    </view>

    <view class="content-section">
      <view class="section-title">常用学习</view>
      <view class="quick-grid">
        <view wx:for="{{quickActions}}" wx:key="action" class="quick-action" data-action="{{item.action}}" bindtap="handleQuickAction">
          <view class="quick-symbol">{{item.symbol}}</view>
          <view class="quick-copy">
            <view class="quick-title">{{item.title}}</view>
            <view class="quick-desc">{{item.desc}}</view>
          </view>
          <view wx:if="{{item.badge}}" class="quick-badge">{{item.badge}}</view>
        </view>
      </view>
    </view>

    <view class="support-card">
      <view class="support-main" bindtap="toggleProfileEdit">
        <view class="support-title-row">
          <view class="support-title">我的资料</view>
          <view class="support-status {{profileCompleteness.statusClass}}">{{profileCompleteness.status}}</view>
        </view>
        <view class="support-desc">{{profileCompleteness.summary}}</view>
        <view class="support-note">{{profileCompleteness.detail}}</view>
      </view>
      <button class="secondary-button" bindtap="toggleProfileEdit">{{profileEditText}}</button>

      <view wx:if="{{profileEditing}}" class="profile-form">
        <input class="form-input" value="{{profileForm.studentName}}" data-field="studentName" bindinput="onBasicInput" placeholder="学生姓名" />
        <input class="form-input" value="{{profileForm.grade}}" data-field="grade" bindinput="onBasicInput" placeholder="年级，例如：五年级" />
        <input class="form-input" value="{{profileForm.schoolName}}" data-field="schoolName" bindinput="onBasicInput" placeholder="学校" />
        <input class="form-input" value="{{profileForm.guardianName}}" data-field="guardianName" bindinput="onBasicInput" placeholder="家长称呼（选填）" />
        <button class="profile-save" bindtap="submitBasicProfile" loading="{{savingBasicProfile}}" disabled="{{savingBasicProfile}}">保存资料</button>
      </view>
    </view>

    <view class="notice-line" bindtap="handleSupportTap">
      <view>
        <view class="notice-title">{{supportNotice.title}}</view>
        <view class="notice-desc">{{supportNotice.desc}}</view>
      </view>
      <view class="notice-action">{{supportNotice.actionText}}</view>
    </view>
  </view>
</view>
