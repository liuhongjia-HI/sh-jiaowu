<view class="me-page" style="padding-top: {{statusBarHeight}}px;">
  <view wx:if="{{loading}}" class="page-state">Syncing learning progress...</view>

  <view wx:elif="{{!me}}" class="login-state">
    <view class="login-title">You are not logged in</view>
    <view class="login-desc">{{emptyMessage}}</view>
    <button class="primary-button" bindtap="goLogin">Log In</button>
  </view>

  <view wx:else class="me-shell">
    <view class="me-toolbar">
      <view class="me-toolbar-icon settings-icon" bindtap="toggleProfileEdit" aria-label="Account Settings">⚙</view>
    </view>

    <view class="profile-card">
      <button class="profile-avatar" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" disabled="{{savingProfile}}" aria-label="Choose WeChat Avatar">
        <image wx:if="{{guardianProfile.avatarUrl}}" class="profile-avatar-image" src="{{guardianProfile.avatarUrl}}" mode="aspectFill"></image>
        <view wx:else class="profile-avatar-fallback" aria-hidden="true">
          <view class="avatar-illustration-body"></view>
          <view class="avatar-illustration-hair"></view>
          <view class="avatar-illustration-face"></view>
          <view class="avatar-illustration-eye avatar-eye-left"></view>
          <view class="avatar-illustration-eye avatar-eye-right"></view>
        </view>
      </button>
      <view class="profile-copy">
        <view class="profile-greeting">Good afternoon,</view>
        <input class="profile-nickname" type="nickname" value="{{guardianProfile.nickname}}" placeholder="WeChat nickname" bindinput="onNicknameInput" bindblur="commitNickname" confirm-type="done" aria-label="WeChat nickname" />
        <button class="profile-phone-action {{studentProfile.phoneAuthorized ? 'authorized' : 'pending'}}" open-type="getPhoneNumber" bindgetphonenumber="authorizePhone" loading="{{savingProfile}}" disabled="{{savingProfile}}" aria-label="Authorize Phone">
          <text>{{studentProfile.phoneHint}}</text>
        </button>
      </view>
      <view class="profile-arrow" bindtap="toggleProfileEdit">›</view>
    </view>

    <view wx:if="{{studentAccounts.length}}" class="student-switcher">
      <view class="student-switcher-label">Current Student</view>
      <view class="student-switcher-list">
        <button wx:for="{{studentAccounts}}" wx:key="studentId" class="student-switch-button {{item.active ? 'active' : ''}} {{!item.canSwitch && !item.active ? 'pending' : ''}}" data-student-id="{{item.studentId}}" bindtap="switchStudent" loading="{{switchingStudentId === item.studentId}}" disabled="{{!item.canSwitch && !item.active || switchingStudentId}}">
          <text>{{item.name}} · {{item.gradeLabel}}</text>
          <text wx:if="{{!item.canSwitch}}" class="student-switch-status">Unavailable</text>
        </button>
        <button class="student-add-button" bindtap="openStudentAddModal">＋ Add Student</button>
      </view>
    </view>

    <view class="me-section recent-section">
      <view class="me-section-head">
        <view class="me-section-title">Continue Learning</view>
        <view class="me-section-more" bindtap="goStudy">Learning Center ›</view>
      </view>
      <view wx:if="{{recentLearning}}" class="recent-card" bindtap="goStudyDetail">
        <view class="recent-cover">
          <view class="recent-cover-circle"></view>
          <view class="recent-cover-art">{{recentLearning.coverIcon || "📖"}}</view>
        </view>
        <view class="recent-copy">
          <view class="recent-title">{{recentLearning.name}}</view>
          <view class="recent-date">Last studied: {{recentLearning.lastStudyAt || "Today"}}</view>
          <view class="recent-progress-row"><text>Completed {{recentLearning.completedLessons}}/{{recentLearning.chapterCount}} lessons</text><text>{{recentLearning.progress}}%</text></view>
          <view class="recent-progress"><view class="recent-progress-bar" style="width: {{recentLearning.progress}}%;"></view></view>
          <view class="recent-cta">Continue Learning <text>›</text></view>
        </view>
      </view>
          <view wx:else class="recent-empty">No learning records yet. Start learning.</view>
    </view>

    <view class="metric-strip">
      <view wx:for="{{overviewMetrics}}" wx:key="label" class="metric-item">
        <view class="metric-value {{item.emphasis ? 'metric-emphasis' : ''}}">{{item.value}}</view>
        <view class="metric-label">{{item.label}}</view>
      </view>
    </view>

    <view class="me-section function-section">
      <view class="me-section-title">Quick Links</view>
      <view class="quick-grid">
        <block wx:for="{{quickActions}}" wx:key="action">
          <view wx:if="{{item.action === 'schedule' || item.action === 'study' || item.action === 'downloads' || item.action === 'favorites' || item.action === 'notices'}}" class="quick-action quick-action-{{item.tone}}" data-action="{{item.action}}" bindtap="handleQuickAction">
            <view class="quick-symbol">{{item.symbol}}</view>
            <view class="quick-title">{{item.title}}</view>
          </view>
        </block>
      </view>
    </view>

    <view wx:if="{{profileEditing}}" class="profile-modal-mask" bindtap="toggleProfileEdit">
      <view class="profile-modal" catchtap="stopModalTap">
        <view class="profile-modal-head">
          <view>
            <view class="profile-modal-title">Edit Profile</view>
            <view class="profile-modal-subtitle">Complete your profile to help your teacher record feedback accurately.</view>
          </view>
          <view class="profile-modal-close" bindtap="toggleProfileEdit">×</view>
        </view>

        <view class="profile-modal-status-row">
          <view class="profile-modal-status {{profileCompleteness.statusClass}}">{{profileCompleteness.status}}</view>
          <view class="profile-modal-status-desc">{{profileCompleteness.summary}}</view>
        </view>

        <view class="profile-form">
          <input class="form-input" value="{{profileForm.studentName}}" data-field="studentName" bindinput="onBasicInput" placeholder="Student name" />
          <view class="form-readonly">
            <view class="form-readonly-value">{{profileGradeLabel || "Grade not provided"}}</view>
            <view class="form-readonly-hint">Your grade updates each school year. Contact your teacher if it is incorrect.</view>
          </view>
          <input class="form-input" value="{{profileForm.schoolName}}" data-field="schoolName" bindinput="onBasicInput" placeholder="School" />
          <input class="form-input" value="{{profileForm.guardianName}}" data-field="guardianName" bindinput="onBasicInput" placeholder="Parent name (optional)" />
          <button class="profile-save" bindtap="submitBasicProfile" loading="{{savingBasicProfile}}" disabled="{{savingBasicProfile}}">Save Profile</button>
        </view>
      </view>
    </view>

    <view wx:if="{{studentAddOpen}}" class="profile-modal-mask" bindtap="closeStudentAddModal">
      <view class="profile-modal" catchtap="stopModalTap">
        <view class="profile-modal-head">
          <view>
            <view class="profile-modal-title">Add Student</view>
            <view class="profile-modal-subtitle">Enter the student's details to switch profiles and start exploring.</view>
          </view>
          <view class="profile-modal-close" bindtap="closeStudentAddModal">×</view>
        </view>
        <view class="profile-form">
          <input class="form-input" value="{{studentAddForm.name}}" data-field="name" bindinput="onStudentAddInput" placeholder="Student name" maxlength="32" />
          <picker mode="selector" range="{{gradeLabels}}" value="{{studentAddGradeIndex}}" bindchange="onStudentAddGradeChange">
            <view class="form-input form-picker {{studentAddForm.grade ? '' : 'placeholder'}}">{{gradeLabels[studentAddGradeIndex] || "Select grade"}}</view>
          </picker>
          <input class="form-input" value="{{studentAddForm.schoolName}}" data-field="schoolName" bindinput="onStudentAddInput" placeholder="School" maxlength="64" />
          <view class="student-add-hint">The profile is available immediately. Courses with trial access include the first chapter.</view>
          <button class="profile-save" bindtap="submitStudentAdd" loading="{{addingStudent}}" disabled="{{addingStudent}}">Add Student</button>
        </view>
      </view>
    </view>
  </view>
</view>
